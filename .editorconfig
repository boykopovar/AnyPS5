# EditorConfig - see https://editorconfig.org
# Keeps editors consistent with the hooks enforced by pre-commit
# (end-of-file-fixer, trailing-whitespace, mixed-line-ending).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2