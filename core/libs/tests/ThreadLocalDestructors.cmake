if(NOT PATTERN)
    set(PATTERN "*.prx")
endif()
file(GLOB modules RELATIVE "${MODULES}" "${MODULES}/${PATTERN}")
if(NOT modules)
    message(FATAL_ERROR "no modules in ${MODULES}")
endif()
set(explicit "__cxa_thread_atexit_nid_postfix|__cxa_thread_atexit_impl_nid_postfix|LibcInternalExtCxaThreadAtexit_nid_postfix")
set(failures "")
set(registering "")
list(LENGTH modules moduleCount)
set(batch 100)
math(EXPR lastBatch "(${moduleCount} - 1) / ${batch}")
foreach(index RANGE ${lastBatch})
    math(EXPR start "${index} * ${batch}")
    list(SUBLIST modules ${start} ${batch} chunk)
    execute_process(COMMAND "${NM}" -A -g --defined-only ${chunk} WORKING_DIRECTORY "${MODULES}"
        OUTPUT_VARIABLE symbols ERROR_VARIABLE errors RESULT_VARIABLE result)
    if(NOT result MATCHES "^[0-9]+$")
        message(FATAL_ERROR "cannot run ${NM}: ${result}")
    endif()
    if(symbols STREQUAL "" AND errors STREQUAL "" AND NOT result EQUAL 0)
        foreach(name IN LISTS chunk)
            list(APPEND failures "${name}: no symbol table to inspect")
        endforeach()
        continue()
    endif()
    if(NOT errors STREQUAL "")
        foreach(name IN LISTS chunk)
            string(FIND "${errors}" " ${name}: " problem)
            if(NOT problem EQUAL -1)
                list(APPEND failures "${name}: no symbol table to inspect")
            endif()
        endforeach()
    endif()
    string(REGEX MATCHALL "[^\n:]+:[0-9a-f]+ T __mingw_cxa_thread_atexit\n" found "${symbols}")
    foreach(line IN LISTS found)
        string(REGEX REPLACE ":[0-9a-f]+ T __mingw_cxa_thread_atexit\n$" "" name "${line}")
        list(APPEND registering "${name}")
    endforeach()
endforeach()
if(registering)
    list(REMOVE_DUPLICATES registering)
endif()
foreach(name IN LISTS registering)
    execute_process(COMMAND "${OBJDUMP}" -d --no-show-raw-insn "${name}" WORKING_DIRECTORY "${MODULES}"
        OUTPUT_VARIABLE code RESULT_VARIABLE result ERROR_QUIET)
    if(NOT result EQUAL 0)
        list(APPEND failures "${name}: cannot disassemble")
        continue()
    endif()
    string(REGEX MATCHALL "\n[0-9a-f]+ <[^>\n]+>:|(call|jmp)[^\n]*<__cxa_thread_atexit>" lines "${code}")
    set(function "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^\n[0-9a-f]+ <([^>\n]+)>:$")
            set(function "${CMAKE_MATCH_1}")
        elseif(NOT function MATCHES "^(${explicit})$")
            list(APPEND failures "${name}: ${function} registers a thread_local destructor")
        endif()
    endforeach()
endforeach()
if(failures)
    list(REMOVE_DUPLICATES failures)
    list(JOIN failures "\n  " text)
    message(FATAL_ERROR "On Windows a thread_local destructor in a module runs after emulated TLS freed the object; keep such objects in HostThreadLocal:\n  ${text}")
endif()
message(STATUS "${moduleCount} files matching ${PATTERN} register no thread_local destructors")
