    target_link_libraries(guest_libressl_bio_tests PRIVATE libSceLibreSsl libc)
    configure_windows_unwind(guest_libressl_bio_tests)
    add_test(NAME guest_libressl_bio COMMAND guest_libressl_bio_tests)
    set_tests_properties(guest_libressl_bio PROPERTIES TIMEOUT 30)
