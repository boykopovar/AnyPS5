foreach(type INT LONG LONG_LONG INTMAX_T)
    string(TOLOWER "${type}" ctype)
    string(REPLACE "_" " " ctype "${ctype}")
    if(type STREQUAL "INTMAX_T")
        set(ctype intmax_t)
    endif()
    set(CMAKE_EXTRA_INCLUDE_FILES stdint.h)
    check_type_size("${ctype}" JEMSPACE_SIZEOF_${type} LANGUAGE C)
    unset(CMAKE_EXTRA_INCLUDE_FILES)
    if(JEMSPACE_SIZEOF_${type} EQUAL 8)
        set(LG_SIZEOF_${type} 3)
    elseif(JEMSPACE_SIZEOF_${type} EQUAL 4)
        set(LG_SIZEOF_${type} 2)
    else()
        message(FATAL_ERROR "Unsupported jemalloc integer size: ${ctype}")
    endif()
endforeach()
