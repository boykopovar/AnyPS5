    "os_unfair_lock_lock|os/lock.h|JEMALLOC_OS_UNFAIR_LOCK")
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 symbol)
    list(GET parts 1 headers)
    list(GET parts 2 feature)
    check_symbol_exists("${symbol}" "${headers}" JEMSPACE_${feature})
    if(JEMSPACE_${feature})
        set(${feature} 1)
    endif()
endforeach()
