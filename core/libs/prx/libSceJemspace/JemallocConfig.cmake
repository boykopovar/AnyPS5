    "secure_getenv|stdlib.h|JEMALLOC_HAVE_SECURE_GETENV"
    "pthread_atfork|pthread.h|JEMALLOC_HAVE_PTHREAD_ATFORK"
    "dlsym|dlfcn.h|JEMALLOC_HAVE_DLSYM"
