function(jemspace_config_header input output)
    file(READ "${input}" content)
    string(REGEX MATCHALL "#undef [A-Za-z0-9_]+" entries "${content}")
    foreach(entry IN LISTS entries)
        string(REPLACE "#undef " "" name "${entry}")
        if(DEFINED ${name})
            string(REPLACE "${entry}\n" "#define ${name} ${${name}}\n" content "${content}")
        endif()
    endforeach()
    file(WRITE "${output}.in" "${content}")
    configure_file("${output}.in" "${output}" @ONLY)
endfunction()
