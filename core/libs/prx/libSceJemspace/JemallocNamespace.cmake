string(REPLACE "|" ";" objects "${OBJECTS}")
execute_process(COMMAND "${NM}" -g ${objects} OUTPUT_VARIABLE symbols COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\r\n" "\n" symbols "${symbols}")
string(REPLACE "\n" ";" lines "${symbols}")
set(names "")
foreach(line IN LISTS lines)
    if(line MATCHES "^[0-9A-Fa-f]+[ \t]+[ABCDGRSTVW][ \t]+([A-Za-z0-9_]+)$")
        set(symbol "${CMAKE_MATCH_1}")
        if(APPLE)
            string(REGEX REPLACE "^_" "" symbol "${symbol}")
        endif()
        if(NOT symbol MATCHES "^anyps5_jemspace_")
            list(APPEND names "${symbol}")
        endif()
    endif()
endforeach()
list(REMOVE_DUPLICATES names)
list(SORT names)
set(header "")
foreach(symbol IN LISTS names)
    string(APPEND header "#define ${symbol} JEMALLOC_N(${symbol})\n")
endforeach()
if(NOT names)
    message(FATAL_ERROR "Could not read jemalloc private symbols with ${NM}")
endif()
file(WRITE "${OUTPUT}.tmp" "${header}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
