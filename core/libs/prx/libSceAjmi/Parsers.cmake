if(BUILD_TESTING)
    add_test_executable(guest_ajmi_parser_aliases_tests ${LIBS_INCLUDE_DIR}/tests/GuestAjmiParserAliases.cpp)
    target_include_directories(guest_ajmi_parser_aliases_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_ajmi_parser_aliases_tests PRIVATE ${CMAKE_DL_LIBS})
    if(WIN32)
        target_link_libraries(guest_ajmi_parser_aliases_tests PRIVATE libc)
    endif()
    configure_windows_unwind(guest_ajmi_parser_aliases_tests)
    add_dependencies(guest_ajmi_parser_aliases_tests guest_ajmi_batch_alias_libraries)
    foreach(variant IN ITEMS unpatched nid)
        if(variant STREQUAL "nid")
            set(ajmiParserModuleDir ${ajmiAliasModuleDir})
            set(ajmiParserModule ${ajmiAliasPatchedModule})
            set(ajmiParserNative ${ajmiAliasNative})
        else()
            set(ajmiParserModuleDir "$<TARGET_FILE_DIR:libSceAjmi>")
            set(ajmiParserModule "$<TARGET_FILE:libSceAjmi>")
            set(ajmiParserNative "$<TARGET_FILE:libSceAjm.native>")
        endif()
        foreach(operation IN ITEMS at9 mp3 errors)
            add_test(NAME guest_ajmi_parser_${operation}_${variant}
                COMMAND guest_ajmi_parser_aliases_tests "${ajmiParserModule}" "${ajmiParserNative}" ${operation} ${variant})
            set_tests_properties(guest_ajmi_parser_${operation}_${variant} PROPERTIES TIMEOUT 20)
            if(WIN32)
                set_tests_properties(guest_ajmi_parser_${operation}_${variant} PROPERTIES ENVIRONMENT_MODIFICATION
                    "PATH=path_list_prepend:${ajmiParserModuleDir}")
            elseif(APPLE)
                set_tests_properties(guest_ajmi_parser_${operation}_${variant} PROPERTIES ENVIRONMENT_MODIFICATION
                    "DYLD_LIBRARY_PATH=path_list_prepend:${ajmiParserModuleDir}")
            else()
                set_tests_properties(guest_ajmi_parser_${operation}_${variant} PROPERTIES ENVIRONMENT_MODIFICATION
                    "LD_LIBRARY_PATH=path_list_prepend:${ajmiParserModuleDir}")
            endif()
        endforeach()
    endforeach()
endif()
