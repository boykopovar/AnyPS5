if(BUILD_TESTING)
    add_test_executable(guest_ajmi_submission_tests ${LIBS_INCLUDE_DIR}/tests/GuestAjmiSubmission.cpp)
    target_include_directories(guest_ajmi_submission_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_ajmi_submission_tests PRIVATE ${CMAKE_DL_LIBS})
    if(WIN32)
        target_link_libraries(guest_ajmi_submission_tests PRIVATE libc)
    endif()
    configure_windows_unwind(guest_ajmi_submission_tests)
    add_dependencies(guest_ajmi_submission_tests guest_ajmi_batch_alias_libraries)
    foreach(variant IN ITEMS unpatched nid)
        if(variant STREQUAL "nid")
            set(ajmiSubmissionModuleDir ${ajmiAliasModuleDir})
        else()
            set(ajmiSubmissionModuleDir ${UNPATCHED_DIR})
        endif()
        foreach(operation IN ITEMS execute errors unsupported)
            add_test(NAME guest_ajmi_submission_${operation}_${variant}
                COMMAND guest_ajmi_submission_tests ${ajmiSubmissionModuleDir} ${operation} ${variant})
            set_tests_properties(guest_ajmi_submission_${operation}_${variant} PROPERTIES TIMEOUT 20)
            if(WIN32)
                set_tests_properties(guest_ajmi_submission_${operation}_${variant} PROPERTIES ENVIRONMENT_MODIFICATION
                    "PATH=path_list_prepend:${ajmiSubmissionModuleDir}")
            elseif(APPLE)
                set_tests_properties(guest_ajmi_submission_${operation}_${variant} PROPERTIES ENVIRONMENT_MODIFICATION
                    "DYLD_LIBRARY_PATH=path_list_prepend:${ajmiSubmissionModuleDir}")
            else()
                set_tests_properties(guest_ajmi_submission_${operation}_${variant} PROPERTIES ENVIRONMENT_MODIFICATION
                    "LD_LIBRARY_PATH=path_list_prepend:${ajmiSubmissionModuleDir}")
            endif()
        endforeach()
    endforeach()
endif()
