file(STRINGS "${FONTCONFIG_SOURCE}/fc-case/CaseFolding.txt" foldLines)
set(data "#pragma once\n\n#include <cstdint>\n#include <string_view>\n\nnamespace fontconfig_data {\n\nstruct Fold { std::uint32_t upper; std::uint32_t lower[3]; unsigned count; };\nconstexpr Fold Folds[] = {\n")
foreach(line IN LISTS foldLines)
    if(line MATCHES "^([0-9A-F]+); ([CF]); ([0-9A-F ]+);")
        set(upper "${CMAKE_MATCH_1}")
        string(STRIP "${CMAKE_MATCH_3}" lower)
        string(REPLACE " " ";" lower "${lower}")
        list(LENGTH lower count)
        if(count GREATER 3)
            message(FATAL_ERROR "Fontconfig case fold exceeds three code points")
        endif()
        if(count EQUAL 1)
            list(GET lower 0 point)
            math(EXPR offset "((0x${point} - 0x${upper} + 32768) & 65535) - 32768")
            math(EXPR point "(0x${upper} + ${offset}) & 0xffffffff" OUTPUT_FORMAT HEXADECIMAL)
            string(REGEX REPLACE "^0x" "" point "${point}")
            set(lower "${point}")
        endif()
        string(APPEND data "    {0x${upper}, {")
        foreach(codepoint IN LISTS lower)
            string(APPEND data "0x${codepoint}, ")
        endforeach()
        string(APPEND data "}, ${count}},\n")
    endif()
endforeach()
string(APPEND data "};\n\nconstexpr std::string_view Languages[] = {\n")
file(READ "${FONTCONFIG_SOURCE}/fc-lang/meson.build" languageSource)
string(REGEX MATCHALL "'[a-z0-9_]+\\.orth'" languages "${languageSource}")
list(SORT languages)
foreach(language IN LISTS languages)
    string(REGEX REPLACE "'([a-z0-9_]+)\\.orth'" "\\1" language "${language}")
    string(REPLACE "_" "-" language "${language}")
    string(APPEND data "    \"${language}\",\n")
endforeach()
string(APPEND data "};\n\nstruct Object { std::string_view name; FcType type; };\nconstexpr Object Objects[] = {\n")
file(READ "${FONTCONFIG_SOURCE}/fontconfig/fontconfig.h" publicHeader)
file(STRINGS "${FONTCONFIG_SOURCE}/src/fcobjs.h" objectLines)
foreach(line IN LISTS objectLines)
    if(line MATCHES "^FC_OBJECT \\( *([A-Z_]+),[ \t]*(FcType[A-Za-z]+),")
        set(object "${CMAKE_MATCH_1}")
        set(type "${CMAKE_MATCH_2}")
        if(NOT publicHeader MATCHES "#define FC_${object}[ \t]+\"([^\"]+)\"")
            message(FATAL_ERROR "Fontconfig object name not found: ${object}")
        endif()
        string(APPEND data "    {\"${CMAKE_MATCH_1}\", ${type}},\n")
    endif()
endforeach()
string(APPEND data "};\n\n}\n")
file(WRITE "${OUTPUT}" "${data}")
