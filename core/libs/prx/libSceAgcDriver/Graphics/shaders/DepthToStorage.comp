#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform texture2D depthPlane;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D texels;
layout(push_constant) uniform Push {
    uvec2 offset;
    uvec2 extent;
} push;

void main() {
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, push.extent))) return;
    const ivec2 position = ivec2(push.offset + gl_GlobalInvocationID.xy);
    imageStore(texels, position, uvec4(floatBitsToUint(texelFetch(depthPlane, position, 0).r)));
}
