#version 450

layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint BLOCK_BYTES = 256u;
layout(constant_id = 2) const uint TILE_FAMILY = 0u;
// 0: tiled input -> linear output (detile); 1: linear input -> tiled output (retile).
layout(constant_id = 3) const uint RETILE = 0u;
// TILE_FAMILY 2: XOR swizzle given per byte-address bit as masks of x (bits 0-11), y (12-23) and
// slice (24-31) element-coordinate bits.
layout(constant_id = 4) const uint EQ0 = 0u;
layout(constant_id = 5) const uint EQ1 = 0u;
layout(constant_id = 6) const uint EQ2 = 0u;
layout(constant_id = 7) const uint EQ3 = 0u;
layout(constant_id = 8) const uint EQ4 = 0u;
layout(constant_id = 9) const uint EQ5 = 0u;
layout(constant_id = 10) const uint EQ6 = 0u;
layout(constant_id = 11) const uint EQ7 = 0u;
layout(constant_id = 12) const uint EQ8 = 0u;
layout(constant_id = 13) const uint EQ9 = 0u;
layout(constant_id = 14) const uint EQ10 = 0u;
layout(constant_id = 15) const uint EQ11 = 0u;
layout(constant_id = 16) const uint EQ12 = 0u;
layout(constant_id = 17) const uint EQ13 = 0u;
layout(constant_id = 18) const uint EQ14 = 0u;
layout(constant_id = 19) const uint EQ15 = 0u;
// Nonzero: block extent in elements (thick 3D blocks are not the thin 2D shape derived below).
layout(constant_id = 20) const uint BLOCK_WIDTH = 0u;
layout(constant_id = 21) const uint BLOCK_HEIGHT = 0u;

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer Input { uint data[]; } inputBuffer;
layout(set = 0, binding = 1, std430) buffer Output { uint data[]; } outputBuffer;

layout(push_constant) uniform Push {
    uint srcBase;
    uint dstBase;
    uint width;
    uint height;
    uint pitchBytes;
    uint blocksPerRow;
    uint tail;
    uint tailX;
    uint tailY;
    uint elementBytes;
    uint slice;
} params;

uint equationBit(uint mask, uvec2 p) {
    uint selected = (p.x & (mask & 0xfffu)) ^ ((p.y << 12) & (mask & 0xfff000u)) ^ ((params.slice << 24) & (mask & 0xff000000u));
    return bitCount(selected) & 1u;
}

uint equationOffset(uvec2 p) {
    const uint eq[16] = uint[16](EQ0, EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7, EQ8, EQ9, EQ10, EQ11, EQ12, EQ13, EQ14, EQ15);
    uint offset = 0u;
    for (uint bit = 0u; bit < 16u; ++bit) {
        offset |= equationBit(eq[bit], p) << bit;
    }
    return offset;
}

uint standardOffset(uint x, uint y) {
    switch (ELEMENT_BYTES) {
        case 1u:
            return ((y << 4) & 0x1f0u) ^ ((y << 5) & 0x400u) ^ (x & 0x00fu) ^
                   ((x << 5) & 0x200u) ^ ((x << 6) & 0x800u);
        case 2u:
            return ((y << 4) & 0x070u) ^ ((y << 5) & 0x100u) ^ ((y << 6) & 0x400u) ^
                   ((x << 1) & 0x00eu) ^ ((x << 4) & 0x080u) ^
                   ((x << 5) & 0x200u) ^ ((x << 6) & 0x800u);
        case 4u:
            return ((y << 4) & 0x070u) ^ ((y << 5) & 0x100u) ^ ((y << 6) & 0x400u) ^
                   ((x << 2) & 0x00cu) ^ ((x << 5) & 0x080u) ^
                   ((x << 6) & 0x200u) ^ ((x << 7) & 0x800u);
        case 8u:
            return ((y << 4) & 0x030u) ^ ((y << 6) & 0x100u) ^ ((y << 7) & 0x400u) ^
                   ((x << 3) & 0x008u) ^ ((x << 5) & 0x0c0u) ^
                   ((x << 6) & 0x200u) ^ ((x << 7) & 0x800u);
        default:
            return ((y << 4) & 0x030u) ^ ((y << 6) & 0x100u) ^ ((y << 7) & 0x400u) ^
                   ((x << 6) & 0x0c0u) ^ ((x << 7) & 0x200u) ^ ((x << 8) & 0x800u);
    }
}

uint standard64Extra(uint x, uint y) {
    switch (ELEMENT_BYTES) {
        case 1u:
            return ((x << 7) & 0x2000u) ^ ((x << 8) & 0x8000u) ^
                   ((y << 6) & 0x1000u) ^ ((y << 7) & 0x4000u);
        case 2u:
            return ((x << 7) & 0x2000u) ^ ((x << 8) & 0x8000u) ^
                   ((y << 7) & 0x1000u) ^ ((y << 8) & 0x4000u);
        case 4u:
            return ((x << 8) & 0x2000u) ^ ((x << 9) & 0x8000u) ^
                   ((y << 7) & 0x1000u) ^ ((y << 8) & 0x4000u);
        case 8u:
            return ((x << 8) & 0x2000u) ^ ((x << 9) & 0x8000u) ^
                   ((y << 8) & 0x1000u) ^ ((y << 9) & 0x4000u);
        default:
            return ((x << 9) & 0x2000u) ^ ((x << 10) & 0x8000u) ^
                   ((y << 8) & 0x1000u) ^ ((y << 9) & 0x4000u);
    }
}


uint blockOffset(uvec2 p) {
    if (TILE_FAMILY == 2u) {
        return equationOffset(p);
    }
    uint offset = standardOffset(p.x, p.y);
    if (BLOCK_BYTES > 4096u) {
        offset ^= standard64Extra(p.x, p.y);
    }
    return offset & (BLOCK_BYTES - 1u);
}

uvec2 blockExtent() {
    if (BLOCK_WIDTH != 0u) {
        return uvec2(BLOCK_WIDTH, BLOCK_HEIGHT);
    }
    uint width;
    if (BLOCK_BYTES <= 256u) {
        width = ELEMENT_BYTES <= 2u ? 16u : (ELEMENT_BYTES <= 8u ? 8u : 4u);
    } else if (BLOCK_BYTES <= 4096u) {
        width = ELEMENT_BYTES <= 2u ? 64u : (ELEMENT_BYTES <= 8u ? 32u : 16u);
    } else {
        width = ELEMENT_BYTES <= 2u ? 256u : (ELEMENT_BYTES <= 8u ? 128u : 64u);
    }
    return uvec2(width, BLOCK_BYTES / (width * ELEMENT_BYTES));
}

void copyElement(uint src, uint dst) {
    if (ELEMENT_BYTES >= 4u) {
        for (uint i = 0u; i < ELEMENT_BYTES; i += 4u) {
            outputBuffer.data[(dst + i) >> 2] = inputBuffer.data[(src + i) >> 2];
        }
    } else {
        uint mask = ELEMENT_BYTES == 1u ? 0xffu : 0xffffu;
        uint value = (inputBuffer.data[src >> 2] >> ((src & 3u) * 8u)) & mask;
        uint shift = (dst & 3u) * 8u;
        atomicAnd(outputBuffer.data[dst >> 2], ~(mask << shift));
        atomicOr(outputBuffer.data[dst >> 2], value << shift);
    }
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= params.width || p.y >= params.height) {
        return;
    }

    uint linearOffset = p.y * params.pitchBytes + p.x * ELEMENT_BYTES;

    if (TILE_FAMILY == 0u) {
        // kLinear: guest and host layouts match; a straight copy at the
        // same pitch, no swizzle.
        copyElement(params.srcBase + linearOffset, params.dstBase + linearOffset);
        return;
    }

    uvec2 swizzle = p;
    uvec2 block = uvec2(0u);
    if (params.tail != 0u) {
        swizzle += uvec2(params.tailX, params.tailY);
    } else {
        block = p / blockExtent();
    }

    uint blockIndex = block.y * params.blocksPerRow + block.x;
    uint tiledOffset = blockIndex * BLOCK_BYTES + blockOffset(swizzle);

    if (RETILE != 0u) {
        copyElement(params.srcBase + linearOffset, params.dstBase + tiledOffset);
    } else {
        copyElement(params.srcBase + tiledOffset, params.dstBase + linearOffset);
    }
}

