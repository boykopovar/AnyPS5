#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint words[]; };
layout(push_constant) uniform Parameters {
    Words source;
    Words arguments;
    uint maxX;
    uint maxY;
    uint maxZ;
    uint threadDimensions;
    uint groupX;
    uint groupY;
    uint groupZ;
    uint foldThreads;
} parameters;

uint groups(uint threads, uint group) {
    return threads / group + (threads % group != 0u ? 1u : 0u);
}

void main() {
    uint x = parameters.source.words[0];
    uint y = parameters.source.words[1];
    uint z = parameters.source.words[2];
    if (parameters.threadDimensions != 0u) {
        parameters.arguments.words[3] = x;
        parameters.arguments.words[4] = y;
        parameters.arguments.words[5] = z;
        x = groups(x, parameters.groupX);
        y = groups(y, parameters.groupY);
        z = groups(z, parameters.groupZ);
    }
    bool valid = x <= parameters.maxX && y <= parameters.maxY && z <= parameters.maxZ;
    uint launchX = x;
    uint launchY = y;
    uint launchZ = z;
    uint countX = 0u;
    uint countY = 0u;
    if (!valid && parameters.foldThreads != 0u) {
        uint rowHigh;
        uint row;
        umulExtended(x, y, rowHigh, row);
        uint totalHigh;
        uint total;
        umulExtended(row, z, totalHigh, total);
        uint invocationsHigh;
        uint invocations;
        umulExtended(total, parameters.foldThreads, invocationsHigh, invocations);
        if (rowHigh == 0u && totalHigh == 0u && invocationsHigh == 0u && total <= parameters.maxX && total <= 0x7fffffffu) {
            valid = true;
            launchX = total;
            launchY = 1u;
            launchZ = 1u;
            countX = x;
            countY = y;
        }
    }
    parameters.arguments.words[0] = valid ? launchX : 0u;
    parameters.arguments.words[1] = valid ? launchY : 0u;
    parameters.arguments.words[2] = valid ? launchZ : 0u;
    if (parameters.foldThreads != 0u) {
        parameters.arguments.words[6] = countX;
        parameters.arguments.words[7] = countY;
    }
}
