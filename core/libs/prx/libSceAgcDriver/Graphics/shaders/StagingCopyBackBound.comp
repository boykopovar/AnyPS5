#version 450

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Result { uint words[]; } result;
layout(set = 0, binding = 1, std430) readonly buffer Snapshot { uint words[]; } snapshot;
layout(set = 0, binding = 2, std430) buffer Target { uint words[]; } target;
layout(set = 0, binding = 3, std430) buffer Counter { uint words[]; } counter;
layout(push_constant) uniform Parameters {
    uint resultBase;
    uint snapshotBase;
    uint targetBase;
    uint count;
    uint always;
    uint counting;
} parameters;

const uint LineWords = 8u;
shared uint lineChanged[64u / LineWords];

uint differingBytes(uint difference) {
    uint folded = difference | (difference >> 1u);
    folded |= folded >> 2u;
    folded |= folded >> 4u;
    return (folded & 0x01010101u) * 0xffu;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    if (lane < 64u / LineWords) lineChanged[lane] = 0u;
    barrier();
    bool inside = index < parameters.count;
    uint value = 0u;
    uint before = 0u;
    uint changed = 0u;
    if (inside) {
        value = result.words[parameters.resultBase + index];
        before = snapshot.words[parameters.snapshotBase + index];
        changed = differingBytes(value ^ before);
        if (changed != 0u || parameters.always != 0u) atomicOr(lineChanged[lane / LineWords], 1u);
    }
    barrier();
    if (!inside || lineChanged[lane / LineWords] == 0u) return;
    uint held = target.words[parameters.targetBase + index];
    uint kept = differingBytes(held ^ before);
    uint stored = parameters.always != 0u ? 0xffffffffu : changed & ~kept;
    target.words[parameters.targetBase + index] = (held & ~stored) | (value & stored);
    if (parameters.counting != 0u && (changed & kept) != 0u) atomicAdd(counter.words[0], 1u);
}
