#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint words[]; };
layout(push_constant) uniform Parameters {
    Words result;
    Words snapshot;
    Words target;
    Words counter;
    uint count;
    uint always;
} parameters;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= parameters.count) return;
    uint value = parameters.result.words[index];
    uint before = parameters.snapshot.words[index];
    uint held = parameters.target.words[index];
    if (parameters.always != 0u || (value != before && held == before)) parameters.target.words[index] = value;
    else if (uint64_t(parameters.counter) != 0ul && held != before) atomicAdd(parameters.counter.words[0], 1u);
}
