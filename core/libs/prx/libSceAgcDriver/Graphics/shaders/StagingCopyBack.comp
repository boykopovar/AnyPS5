#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint words[]; };
layout(push_constant) uniform Parameters {
    Words result;
    Words snapshot;
    Words target;
    Words counter;
    uint count;
    uint always;
} parameters;

const uint LineWords = 8u;
shared uint lineChanged[64u / LineWords];

uint differingBytes(uint difference) {
    uint folded = difference | (difference >> 1u);
    folded |= folded >> 2u;
    folded |= folded >> 4u;
    return (folded & 0x01010101u) * 0xffu;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    if (lane < 64u / LineWords) lineChanged[lane] = 0u;
    barrier();
    bool inside = index < parameters.count;
    uint value = 0u;
    uint before = 0u;
    uint changed = 0u;
    if (inside) {
        value = parameters.result.words[index];
        before = parameters.snapshot.words[index];
        changed = differingBytes(value ^ before);
        if (changed != 0u || parameters.always != 0u) atomicOr(lineChanged[lane / LineWords], 1u);
    }
    barrier();
    if (!inside || lineChanged[lane / LineWords] == 0u) return;
    uint held = parameters.target.words[index];
    uint kept = differingBytes(held ^ before);
    uint stored = parameters.always != 0u ? 0xffffffffu : changed & ~kept;
    parameters.target.words[index] = (held & ~stored) | (value & stored);
    if (uint64_t(parameters.counter) != 0ul && (changed & kept) != 0u) atomicAdd(parameters.counter.words[0], 1u);
}
