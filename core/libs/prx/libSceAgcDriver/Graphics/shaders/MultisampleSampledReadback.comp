#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Output { uint data[]; } destinationBuffer;
#if READ_DEPTH
layout(set = 0, binding = 1) uniform texture2DMSArray sourceImage;
#else
layout(set = 0, binding = 1) uniform utexture2DMSArray sourceImage;
#endif
layout(push_constant) uniform Push {
    uint width;
    uint height;
    uint layers;
    uint fragments;
    uint firstElement;
    uint elements;
    uint rowThreads;
} params;

uvec4 loadElement(uint index) {
    uint element = params.firstElement + index;
    uint pixel = element / params.fragments;
    ivec3 coordinate = ivec3(pixel % params.width, (pixel / params.width) % params.height, pixel / (params.width * params.height));
#if READ_DEPTH
    return floatBitsToUint(texelFetch(sourceImage, coordinate, int(element % params.fragments)));
#else
    return texelFetch(sourceImage, coordinate, int(element % params.fragments));
#endif
}

void main() {
    uint index = gl_GlobalInvocationID.y * params.rowThreads + gl_GlobalInvocationID.x;
    if (ELEMENT_BYTES < 4u) {
        uint packedElements = 4u / ELEMENT_BYTES;
        if (index >= params.elements / packedElements + uint(params.elements % packedElements != 0u)) return;
        uint first = index * packedElements;
        uint value = 0u;
        uint mask = 0u;
        for (uint packed = 0u; packed < packedElements && first + packed < params.elements; ++packed) {
            uint shift = packed * ELEMENT_BYTES * 8u;
            uint bits = ELEMENT_BYTES == 1u ? 255u : 65535u;
            value |= (loadElement(first + packed).x & bits) << shift;
            mask |= bits << shift;
        }
        if (mask != 0xffffffffu) value |= destinationBuffer.data[index] & ~mask;
        destinationBuffer.data[index] = value;
    } else {
        if (index >= params.elements) return;
        uvec4 value = loadElement(index);
        for (uint component = 0u; component < ELEMENT_BYTES / 4u; ++component) destinationBuffer.data[index * (ELEMENT_BYTES / 4u) + component] = value[component];
    }
}
