#version 450

layout(local_size_x = 8, local_size_y = 8) in;

#if MULTISAMPLED
layout(set = 0, binding = 0) uniform sampler2DMS depth;
#else
layout(set = 0, binding = 0) uniform sampler2D depth;
#endif
layout(set = 0, binding = 1, r32f) writeonly uniform image2D target;

layout(push_constant) uniform Push {
    uint width;
    uint height;
    int sampleIndex;
} push;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= push.width || pixel.y >= push.height) return;
#if MULTISAMPLED
    float value = texelFetch(depth, ivec2(pixel), push.sampleIndex).r;
#else
    float value = texelFetch(depth, ivec2(pixel), 0).r;
#endif
    imageStore(target, ivec2(pixel), vec4(value, 0.0, 0.0, 0.0));
}
