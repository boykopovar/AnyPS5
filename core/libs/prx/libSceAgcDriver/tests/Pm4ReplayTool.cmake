foreach(variable TOOL CAPTURE)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "${variable} is not set")
    endif()
endforeach()

execute_process(COMMAND "${TOOL}" "${CAPTURE}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "1")
    message(FATAL_ERROR "agc_pm4_replay exited with ${code} instead of 1 on a capture with an unreleased wait:\n${output}${errors}")
endif()
if(NOT output MATCHES "waits 8: released [4-6] \\([^)]*\\), unknown [1-3] \\(cross-queue timing [0-2]\\), unreleased 1\n")
    message(FATAL_ERROR "agc_pm4_replay does not report seven released or unknown waits and one unreleased:\n${output}")
endif()
if(NOT output MATCHES "the tool does not model cross-queue timing")
    message(FATAL_ERROR "agc_pm4_replay does not say that it does not model cross-queue timing:\n${output}")
endif()
if(NOT output MATCHES "unreleased waits, then unknown waits, newest first:\n\nUNRELEASED #3 queue 0x0 [^\n]*\n  unreleased by the GPU; a CPU store could release it")
    message(FATAL_ERROR "agc_pm4_replay does not list the unreleased wait of submission #3:\n${output}")
endif()

execute_process(COMMAND "${TOOL}" "${CAPTURE}" --full RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "1" OR NOT output MATCHES "submissions in execution order per queue:")
    message(FATAL_ERROR "agc_pm4_replay --full exited with ${code} or printed no submissions:\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" "${CAPTURE}/missing" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "2" OR NOT errors MATCHES "cannot open")
    message(FATAL_ERROR "agc_pm4_replay exited with ${code} instead of 2 on a missing capture:\n${output}${errors}")
endif()

set(unicodeCapture "${CAPTURE}-ação-日本")
file(REMOVE_RECURSE "${unicodeCapture}")
file(COPY "${CAPTURE}/" DESTINATION "${unicodeCapture}")
execute_process(COMMAND "${TOOL}" "${unicodeCapture}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
file(REMOVE_RECURSE "${unicodeCapture}")
if(NOT code STREQUAL "1" OR NOT output MATCHES "unreleased 1\n")
    message(FATAL_ERROR "agc_pm4_replay exited with ${code} on a copy of the capture under a non-ASCII path:\n${output}${errors}")
endif()
