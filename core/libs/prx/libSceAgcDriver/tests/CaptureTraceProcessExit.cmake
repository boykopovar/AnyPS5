if(NOT CMAKE_ARGC EQUAL 6)
    message(FATAL_ERROR "Expected fixture, module and output root arguments")
endif()
set(fixture "${CMAKE_ARGV3}")
set(module "${CMAKE_ARGV4}")
set(outputRoot "${CMAKE_ARGV5}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef runId)
set(runDirectory "${outputRoot}/capture-trace-process-exit-${runId}")
file(MAKE_DIRECTORY "${runDirectory}")
set(tracePath "${runDirectory}/trace.log")
set(receiptPath "${runDirectory}/detach.receipt")
set(ENV{CAPTURE_TRACE_TEST_EXIT_RECEIPT} "${receiptPath}")
set(ENV{APS5_CAPTURE_TRACE} "1")
set(ENV{APS5_CAPTURE_TRACE_PATH} "${tracePath}")
set(ENV{APS5_CAPTURE_TRACE_PREFIXES} "")
execute_process(
        COMMAND "${fixture}" dll-process-exit "${module}"
        WORKING_DIRECTORY "${runDirectory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 8
)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Capture trace process exit failed: ${result}\n${output}\n${error}")
endif()
if(NOT EXISTS "${receiptPath}")
    message(FATAL_ERROR "Capture trace process exit bypassed DLL teardown")
endif()
file(READ "${receiptPath}" receipt)
if(receipt STREQUAL "")
    message(FATAL_ERROR "Capture trace process exit bypassed DLL teardown")
endif()
if(NOT receipt STREQUAL "P")
    message(FATAL_ERROR "Capture trace used explicit unload instead of process-termination DLL teardown: ${receipt}")
endif()
if(NOT EXISTS "${tracePath}")
    message(FATAL_ERROR "Capture trace process exit lost its trace file")
endif()
file(STRINGS "${tracePath}" lines)
list(LENGTH lines count)
if(NOT count EQUAL 33)
    message(FATAL_ERROR "Capture trace process exit wrote ${count} lines instead of 32 records and one summary")
endif()
foreach(item RANGE 0 31)
    list(GET lines ${item} line)
    math(EXPR sequence "${item} + 1")
    if(NOT line MATCHES "^${sequence} [0-9]+us unload-record item=${item}$")
        message(FATAL_ERROR "Capture trace process exit lost or reordered record ${item}: ${line}")
    endif()
endforeach()
list(GET lines 32 summary)
if(NOT summary MATCHES "^33 [0-9]+us capture-trace-summary dropped=0$")
    message(FATAL_ERROR "Capture trace process exit lost its final summary: ${summary}")
endif()
message(STATUS "Capture trace exited through DLL teardown with 32 ordered records and one summary")
