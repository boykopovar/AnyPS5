if(BUILD_TESTING)
    set_tests_properties(agc_driver_image_packed_signed PROPERTIES TIMEOUT 30)
    foreach(signedPackedFormat IN ITEMS 35 38 42 45 49)
        set(signedPackedTest agc_driver_image_packed_signed_${signedPackedFormat})
        add_test(NAME ${signedPackedTest} COMMAND agc_driver_image_packed_signed_tests ${signedPackedFormat})
        set_tests_properties(${signedPackedTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30)
        if(WIN32)
            set_tests_properties(${signedPackedTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
