if(BUILD_TESTING)
    set_target_properties(agc_driver_image_packed_signed_tests PROPERTIES EXCLUDE_FROM_ALL OFF)
    add_test(NAME agc_driver_image_packed_signed COMMAND agc_driver_image_packed_signed_tests 31)
    set(signedPackedTests agc_driver_image_packed_signed)
    foreach(signedPackedFormat IN ITEMS 35 38 42 45 49)
        set(signedPackedTest agc_driver_image_packed_signed_${signedPackedFormat})
        add_test(NAME ${signedPackedTest} COMMAND agc_driver_image_packed_signed_tests ${signedPackedFormat})
        list(APPEND signedPackedTests ${signedPackedTest})
    endforeach()
    set_tests_properties(${signedPackedTests} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30)
    if(WIN32)
        set_tests_properties(${signedPackedTests} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
