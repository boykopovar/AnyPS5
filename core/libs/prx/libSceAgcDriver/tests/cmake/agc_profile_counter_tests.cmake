add_test_executable(agc_profile_counter_tests EXCLUDE_FROM_ALL tests/ProfileCounter.cpp)
target_include_directories(agc_profile_counter_tests PRIVATE ${LIBS_INCLUDE_DIR})
target_link_libraries(agc_profile_counter_tests PRIVATE libc)
set_target_properties(agc_profile_counter_tests PROPERTIES CXX_EXTENSIONS OFF)
configure_windows_unwind(agc_profile_counter_tests)
if(BUILD_TESTING)
    set_target_properties(agc_profile_counter_tests PROPERTIES EXCLUDE_FROM_ALL OFF)
    add_test(NAME agc_profile_counter COMMAND agc_profile_counter_tests)
    set_tests_properties(agc_profile_counter PROPERTIES TIMEOUT 30)
    add_test(NAME agc_profile_counter_shared COMMAND agc_profile_counter_tests)
    set_tests_properties(agc_profile_counter_shared PROPERTIES TIMEOUT 30 ENVIRONMENT APS5_SHARED_PROFILE_COUNTERS=1)
    if(WIN32)
        add_test(NAME agc_profile_counter_tls_expansion COMMAND agc_profile_counter_tests --tls-expansion)
        set_tests_properties(agc_profile_counter_tls_expansion PROPERTIES TIMEOUT 30)
        set_tests_properties(agc_profile_counter agc_profile_counter_shared agc_profile_counter_tls_expansion PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
