if(BUILD_TESTING)
    add_test(NAME agc_driver_dcc_keys_rewrite_after_memo COMMAND agc_driver_dcc_keys_first_write_tests --rewrite-after-memo)
    add_test(NAME agc_driver_dcc_keys_rewrite_after_refresh_proof COMMAND agc_driver_dcc_keys_first_write_tests --rewrite-after-refresh-proof)
    add_test(NAME agc_driver_dcc_keys_rewrite_after_epoch_proof COMMAND agc_driver_dcc_keys_first_write_tests --rewrite-after-epoch-proof)
    add_test(NAME agc_driver_dcc_keys_partial_rewrite_keeps_store COMMAND agc_driver_dcc_keys_first_write_tests --partial-rewrite-keeps-store)
    add_test(NAME agc_driver_dcc_keys_write_beside_keys_keeps_store COMMAND agc_driver_dcc_keys_first_write_tests --write-beside-keys-keeps-store)
    add_test(NAME agc_driver_dcc_keys_rewrite_to_register_clear COMMAND agc_driver_dcc_keys_first_write_tests --rewrite-to-register-clear)
    set_tests_properties(agc_driver_dcc_keys_rewrite_after_memo agc_driver_dcc_keys_rewrite_after_refresh_proof agc_driver_dcc_keys_partial_rewrite_keeps_store agc_driver_dcc_keys_write_beside_keys_keeps_store agc_driver_dcc_keys_rewrite_to_register_clear PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_HOST_IMPORT=1;APS5_NO_DRAW_PIPELINE=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    set_tests_properties(agc_driver_dcc_keys_rewrite_after_epoch_proof PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_HOST_IMPORT=1;APS5_DRAW_PIPELINE=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    add_test(NAME agc_driver_dcc_keys_rewrite_after_epoch_proof_committer COMMAND agc_driver_dcc_keys_first_write_tests --rewrite-after-epoch-proof)
    set_tests_properties(agc_driver_dcc_keys_rewrite_after_epoch_proof_committer PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_HOST_IMPORT=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    foreach(gate IN ITEMS "committer|on" "finisher|on|APS5_DRAW_PIPELINE=1" "inline|off|APS5_PIPELINED_DRAWS=0" "finisher_inline|off|APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=0" "locked_prepare|off|APS5_LOCKED_DRAW_PREPARE=1" "switched_off|off|APS5_NO_EPOCH_PROOFS=1" "finisher_switched_off|off|APS5_DRAW_PIPELINE=1;APS5_NO_EPOCH_PROOFS=1")
        string(REPLACE "|" ";" fields "${gate}")
        list(GET fields 0 name)
        list(GET fields 1 expected)
        set(test agc_driver_epoch_proof_gate_${name})
        add_test(NAME ${test} COMMAND agc_driver_dcc_keys_first_write_tests --epoch-proof-gate ${expected})
        set_tests_properties(${test} PROPERTIES
                ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_HOST_IMPORT=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        list(LENGTH fields count)
        if(count GREATER 2)
            list(SUBLIST fields 2 -1 extra)
            set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT ${extra})
        endif()
        if(WIN32)
            set_tests_properties(${test} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    if(WIN32)
        set_tests_properties(agc_driver_dcc_keys_rewrite_after_memo agc_driver_dcc_keys_rewrite_after_refresh_proof agc_driver_dcc_keys_rewrite_after_epoch_proof agc_driver_dcc_keys_rewrite_after_epoch_proof_committer agc_driver_dcc_keys_partial_rewrite_keeps_store agc_driver_dcc_keys_write_beside_keys_keeps_store agc_driver_dcc_keys_rewrite_to_register_clear PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
