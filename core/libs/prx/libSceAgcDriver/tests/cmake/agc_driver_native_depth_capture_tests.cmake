if(BUILD_TESTING)
    add_dependencies(agc_driver_native_depth_capture_tests agc_frame_replay)
    set_tests_properties(agc_driver_native_depth_capture PROPERTIES TIMEOUT 30)
    add_test(NAME agc_driver_native_depth_capture_replay COMMAND agc_driver_native_depth_capture_tests --capture $<TARGET_FILE:agc_frame_replay>)
    set_tests_properties(agc_driver_native_depth_capture_replay PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_FRAME_CAPTURE=${CMAKE_CURRENT_BINARY_DIR}/native-depth-capture;APS5_FRAME_CAPTURE_AT_FLIP=1;APS5_FRAME_CAPTURE_FRAMES=1;APS5_FRAME_CAPTURE_MIN_FREE_BYTES=0" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    foreach(case mirrorable_stencil cross_aspect preflight retained_view)
        add_test(NAME agc_driver_native_depth_capture_${case} COMMAND agc_driver_native_depth_capture_tests --${case})
        set_tests_properties(agc_driver_native_depth_capture_${case} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_PIPELINE_JOURNAL=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(agc_driver_native_depth_capture_${case} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    if(WIN32)
        set_tests_properties(agc_driver_native_depth_capture_replay PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
