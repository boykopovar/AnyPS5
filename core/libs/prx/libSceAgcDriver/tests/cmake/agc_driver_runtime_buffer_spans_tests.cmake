if(BUILD_TESTING)
    foreach(components RANGE 2 4)
        foreach(mode IN ITEMS spans reference)
            set(test agc_driver_runtime_buffer_spans_x${components}_${mode})
            set(argument --check-spans)
            set(environment "ANYPS5_NO_SHADER_CACHE=1;APS5_SPIRV_OPT=none;APS5_DRAW_PIPELINE=1;APS5_PIPELINE_DISPATCH=1")
            if(mode STREQUAL reference)
                set(argument --reference)
                list(APPEND environment "APS5_BDA_BYTE_READS=1")
            endif()
            add_test(NAME ${test} COMMAND agc_driver_runtime_buffer_spans_tests ${components} ${argument})
            set_tests_properties(${test} PROPERTIES ENVIRONMENT "${environment}" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
            if(WIN32)
                set_tests_properties(${test} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
    foreach(mode IN ITEMS stop barrier)
        set(test agc_driver_runtime_buffer_spans_fault_${mode})
        set(argument)
        if(mode STREQUAL barrier)
            set(argument --barrier)
        endif()
        add_test(NAME ${test} COMMAND agc_driver_runtime_buffer_spans_tests 4 --fault ${argument})
        set_tests_properties(${test} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${test} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
