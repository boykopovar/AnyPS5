if(BUILD_TESTING)
    foreach(wave IN ITEMS 32 64)
        foreach(rounding IN ITEMS 1 2 3)
            foreach(integer IN ITEMS 0 1)
                set(testName agc_driver_f16_directed_rounding_wave${wave}_round${rounding}_integer${integer})
                add_test(NAME ${testName} COMMAND agc_driver_f16_directed_rounding_tests ${wave} ${rounding} ${integer})
                set_tests_properties(${testName} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
                if(WIN32)
                    set_tests_properties(${testName} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
                endif()
            endforeach()
        endforeach()
    endforeach()
endif()
