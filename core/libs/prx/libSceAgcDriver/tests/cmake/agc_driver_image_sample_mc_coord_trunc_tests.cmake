if(BUILD_TESTING)
    foreach(clamp 0 1 2 3 6)
        foreach(filter point linear)
            foreach(trunc 0 1)
                foreach(dimension 1d 2d)
                    set(mcCoordTest agc_driver_image_sample_mc_coord_trunc_${clamp}_${filter}_${trunc}_${dimension})
                    add_test(NAME ${mcCoordTest} COMMAND agc_driver_image_sample_unnormalized_tests --mc ${clamp} ${filter} ${trunc} ${dimension})
                    set_tests_properties(${mcCoordTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 TIMEOUT 30)
                    if(WIN32)
                        set_tests_properties(${mcCoordTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endforeach()
endif()
