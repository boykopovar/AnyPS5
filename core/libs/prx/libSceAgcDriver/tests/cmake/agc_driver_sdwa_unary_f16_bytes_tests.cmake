if(BUILD_TESTING)
    set(sdwaUnaryF16Opcodes rcp sqrt rsq log exp floor ceil trunc rndne fract sin cos)
    foreach(sdwaUnaryF16Index RANGE 0 11)
        list(GET sdwaUnaryF16Opcodes ${sdwaUnaryF16Index} sdwaUnaryF16Opcode)
        foreach(sdwaUnaryF16Wave IN ITEMS 32 64)
            foreach(sdwaUnaryF16SourceMode IN ITEMS 0 1)
                if(sdwaUnaryF16Index EQUAL 0 AND sdwaUnaryF16Wave EQUAL 32 AND sdwaUnaryF16SourceMode EQUAL 0)
                    continue()
                endif()
                set(sdwaUnaryF16Test agc_driver_sdwa_unary_f16_bytes_${sdwaUnaryF16Opcode}_wave${sdwaUnaryF16Wave}_sources${sdwaUnaryF16SourceMode})
                add_test(NAME ${sdwaUnaryF16Test} COMMAND agc_driver_sdwa_unary_f16_bytes_tests ${sdwaUnaryF16Index} ${sdwaUnaryF16Wave} ${sdwaUnaryF16SourceMode})
                set_tests_properties(${sdwaUnaryF16Test} PROPERTIES
                        ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
                if(WIN32)
                    set_tests_properties(${sdwaUnaryF16Test} PROPERTIES ENVIRONMENT_MODIFICATION
                            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
                endif()
            endforeach()
        endforeach()
    endforeach()
endif()
