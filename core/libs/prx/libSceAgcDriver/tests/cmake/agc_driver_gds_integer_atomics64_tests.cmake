if(BUILD_TESTING)
    set_tests_properties(agc_driver_gds_integer_atomics64 PROPERTIES TIMEOUT 30)
    foreach(mode IN ITEMS exchanges contention bounds requirements alignment coherence exchange-contention)
        set(name agc_driver_gds_integer_atomics64_${mode})
        add_test(NAME ${name} COMMAND agc_driver_gds_integer_atomics64_tests ${mode})
        set_tests_properties(${name} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30)
        if(WIN32)
            set_tests_properties(${name} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    add_test(NAME agc_driver_gds_integer_atomics64_copied COMMAND agc_driver_gds_integer_atomics64_tests)
    set_tests_properties(agc_driver_gds_integer_atomics64_copied PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_HOST_IMPORT=1;APS5_NO_SHARED_GDS=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30)
    if(WIN32)
        set_tests_properties(agc_driver_gds_integer_atomics64_copied PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
