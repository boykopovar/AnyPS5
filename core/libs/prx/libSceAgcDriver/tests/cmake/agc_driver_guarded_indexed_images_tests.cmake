if(BUILD_TESTING)
    foreach(mode IN ITEMS fragment fault32 fault64 wrap faultwrap32 faultwrap64)
        set(test agc_driver_guarded_indexed_images_${mode})
        add_test(NAME ${test} COMMAND agc_driver_guarded_indexed_images_tests --${mode})
        set_tests_properties(${test} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_VERIFY_SRT_TAPE=1;APS5_VERIFY_SRT_COMPACT=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${test} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(mode IN ITEMS compute fragment wrap)
        set(test agc_driver_guarded_indexed_images_${mode}_interpreted)
        set(argument)
        if(NOT mode STREQUAL compute)
            set(argument --${mode})
        endif()
        add_test(NAME ${test} COMMAND agc_driver_guarded_indexed_images_tests ${argument})
        set_tests_properties(${test} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_SRT_TAPE=1;APS5_VERIFY_SRT_COMPACT=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${test} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
