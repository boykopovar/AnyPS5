if(BUILD_TESTING)
    foreach(mode IN ITEMS point mirrored descriptor_controls)
        string(REPLACE "_" "-" argument "${mode}")
        foreach(forced IN ITEMS OFF ON)
            set(name agc_driver_image_sample_unnormalized_${mode})
            set(arguments --${argument})
            if(forced)
                string(APPEND name _without_compute_derivatives)
                list(APPEND arguments --without-compute-derivatives)
            endif()
            add_test(NAME ${name} COMMAND agc_driver_image_sample_unnormalized_tests ${arguments})
            set_tests_properties(${name} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;ANYPS5_REQUIRE_VULKAN=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
            if(WIN32)
                set_tests_properties(${name} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
endif()
