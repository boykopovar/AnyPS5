if(BUILD_TESTING)
    add_test(NAME agc_driver_batch_cap_64 COMMAND agc_driver_batch_cap_tests cap 64)
    add_test(NAME agc_driver_batch_cap_off COMMAND agc_driver_batch_cap_tests cap 0)
