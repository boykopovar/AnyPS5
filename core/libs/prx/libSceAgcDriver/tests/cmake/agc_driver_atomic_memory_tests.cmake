add_test_executable(agc_driver_atomic_memory_tests EXCLUDE_FROM_ALL tests/AtomicMemory.cpp)
target_include_directories(agc_driver_atomic_memory_tests PRIVATE ${LIBS_INCLUDE_DIR})
target_link_libraries(agc_driver_atomic_memory_tests PRIVATE libSceAgcDriver libc)
configure_windows_unwind(agc_driver_atomic_memory_tests)
if(BUILD_TESTING)
    set_target_properties(agc_driver_atomic_memory_tests PROPERTIES EXCLUDE_FROM_ALL FALSE)
    foreach(mode IN ITEMS integers protocol concurrent32 concurrent64)
        add_test(NAME agc_driver_atomic_memory_${mode} COMMAND agc_driver_atomic_memory_tests ${mode})
        set_tests_properties(agc_driver_atomic_memory_${mode} PROPERTIES TIMEOUT 60)
        if(WIN32)
            set_tests_properties(agc_driver_atomic_memory_${mode} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(mode IN ITEMS compute deferred)
        add_test(NAME agc_driver_atomic_memory_order_${mode} COMMAND agc_driver_atomic_memory_order_tests ${mode})
        set_tests_properties(agc_driver_atomic_memory_order_${mode} PROPERTIES TIMEOUT 60 SKIP_RETURN_CODE 77)
        if(WIN32)
            set_tests_properties(agc_driver_atomic_memory_order_${mode} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
