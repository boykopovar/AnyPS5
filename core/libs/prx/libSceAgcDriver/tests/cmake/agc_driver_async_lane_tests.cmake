    endforeach()
    set_tests_properties(agc_driver_async_recorder_safety PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_ASSERT_GPU_LOCK=1")
    foreach(test IN ITEMS lane_open_serial lane_template_edge lane_consumed_label lane_overlap_stress lane_forward_edge lane_lease_wait lane_open_wait)
