    set_tests_properties(agc_driver_depth_plane_buffer_memory_async PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 60 FAIL_REGULAR_EXPRESSION "SYNC-HAZARD-|VUID-")
    set_tests_properties(agc_driver_copied_writer_label_order_async PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 60 FAIL_REGULAR_EXPRESSION "SYNC-HAZARD-|VUID-")
    add_test(NAME agc_driver_lane_open_serial_timing COMMAND agc_driver_lane_open_serial_tests)
    set_tests_properties(agc_driver_lane_open_serial_timing PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PROFILE_GPU=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 60 FAIL_REGULAR_EXPRESSION "SYNC-HAZARD-|VUID-")
