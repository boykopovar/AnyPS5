if(BUILD_TESTING)
    set_tests_properties(agc_driver_stencil_plane_ownership PROPERTIES TIMEOUT 30)
    foreach(case d16 readonly cpu cpu_fresh clear independent copy_failure)
        add_test(NAME agc_driver_stencil_plane_ownership_${case} COMMAND agc_driver_stencil_plane_ownership_tests ${case})
        set_tests_properties(agc_driver_stencil_plane_ownership_${case} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_PIPELINE_JOURNAL=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(agc_driver_stencil_plane_ownership_${case} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
