if(BUILD_TESTING)
    add_test(NAME agc_driver_mesh_reuse_indirect_pixels COMMAND agc_driver_mesh_draw_relocation_tests mesh-reuse-indirect)
    set_tests_properties(agc_driver_mesh_reuse_indirect_pixels PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_MESH_REUSE=1" SKIP_RETURN_CODE 77 TIMEOUT 60)
    if(WIN32)
        set_tests_properties(agc_driver_mesh_reuse_indirect_pixels PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
    foreach(pipeline IN ITEMS inline pipelined)
        foreach(records IN ITEMS both left right none)
            set(testName agc_driver_mesh_reuse_indirect_multi_${pipeline}_${records})
            add_test(NAME ${testName} COMMAND agc_driver_mesh_draw_relocation_tests mesh-reuse-indirect-multi-${records})
            if(pipeline STREQUAL "inline")
                set(testEnvironment "ANYPS5_NO_SHADER_CACHE=1;APS5_MESH_REUSE=1;APS5_PIPELINED_DRAWS=0;APS5_NO_PIPELINED_INDIRECT=1")
            else()
                set(testEnvironment "ANYPS5_NO_SHADER_CACHE=1;APS5_MESH_REUSE=1;APS5_PIPELINED_DRAWS=32;APS5_DRAW_PIPELINE=1")
            endif()
            set_tests_properties(${testName} PROPERTIES ENVIRONMENT "${testEnvironment}" SKIP_RETURN_CODE 77 TIMEOUT 30)
            if(WIN32)
                set_tests_properties(${testName} PROPERTIES ENVIRONMENT_MODIFICATION
                        "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
endif()
