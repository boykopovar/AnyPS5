add_test_executable(agc_pipeline_library_workers_tests EXCLUDE_FROM_ALL tests/PipelineLibraryWorkers.cpp Graphics/src/PipelineLibrary.cpp)
target_include_directories(agc_pipeline_library_workers_tests PRIVATE ${LIBS_INCLUDE_DIR} ${CMAKE_SOURCE_DIR}/core/shader/recompiler ${ANYPS5_VULKAN_HEADERS_INCLUDE_DIR})
target_link_libraries(agc_pipeline_library_workers_tests PRIVATE libSceAgcDriver libc)
set_target_properties(agc_pipeline_library_workers_tests PROPERTIES CXX_EXTENSIONS OFF)
configure_windows_unwind(agc_pipeline_library_workers_tests)

if(BUILD_TESTING)
    set_target_properties(agc_pipeline_library_workers_tests PROPERTIES EXCLUDE_FROM_ALL OFF)
    add_test(NAME agc_pipeline_library_workers COMMAND agc_pipeline_library_workers_tests)
    set_tests_properties(agc_pipeline_library_workers PROPERTIES TIMEOUT 15 ENVIRONMENT "APS5_PIPELINE_LTO_THREADS=2")
    add_test(NAME agc_pipeline_library_workers_burst COMMAND agc_pipeline_library_workers_tests burst)
    set_tests_properties(agc_pipeline_library_workers_burst PROPERTIES TIMEOUT 15 ENVIRONMENT "APS5_PIPELINE_LTO_THREADS=2")
    set(workerTests agc_pipeline_library_workers agc_pipeline_library_workers_burst)
    foreach(case negative=-1 text=abc zero=0 suffix=8x above_hardware=100000)
        string(REPLACE "=" ";" parts "${case}")
        list(GET parts 0 name)
        list(GET parts 1 value)
        add_test(NAME agc_pipeline_library_workers_invalid_${name} COMMAND agc_pipeline_library_workers_tests invalid)
        set_tests_properties(agc_pipeline_library_workers_invalid_${name} PROPERTIES TIMEOUT 15 ENVIRONMENT "APS5_PIPELINE_LTO_THREADS=${value}")
        list(APPEND workerTests agc_pipeline_library_workers_invalid_${name})
    endforeach()
    if(WIN32)
        foreach(test IN LISTS workerTests)
            set_tests_properties(${test} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endforeach()
    endif()
endif()
