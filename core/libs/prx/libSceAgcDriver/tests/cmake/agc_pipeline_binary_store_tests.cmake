add_test_executable(agc_pipeline_binary_store_tests EXCLUDE_FROM_ALL tests/PipelineBinaryStore.cpp Graphics/src/PipelineBinaryStore.cpp)
target_include_directories(agc_pipeline_binary_store_tests PRIVATE ${LIBS_INCLUDE_DIR} ${CMAKE_SOURCE_DIR}/core/shader/recompiler ${ANYPS5_VULKAN_HEADERS_INCLUDE_DIR})
target_link_libraries(agc_pipeline_binary_store_tests PRIVATE shader_recompiler_agc_driver libSceAgcDriver libc)
set_target_properties(agc_pipeline_binary_store_tests PROPERTIES CXX_EXTENSIONS OFF)
configure_windows_unwind(agc_pipeline_binary_store_tests)

if(BUILD_TESTING)
    set_target_properties(agc_pipeline_binary_store_tests PROPERTIES EXCLUDE_FROM_ALL OFF)
    add_test(NAME agc_pipeline_binary_store COMMAND agc_pipeline_binary_store_tests)
    set_tests_properties(agc_pipeline_binary_store PROPERTIES TIMEOUT 25)
    foreach(policy default unsafe optout nvk invalid-optin identity)
        string(REPLACE "-" "_" suffix "${policy}")
        add_test(NAME agc_pipeline_binary_store_driver_${suffix} COMMAND agc_pipeline_binary_store_tests --driver-${policy})
        set_tests_properties(agc_pipeline_binary_store_driver_${suffix} PROPERTIES TIMEOUT 25)
        if(WIN32)
            set_tests_properties(agc_pipeline_binary_store_driver_${suffix} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(query global pipeline)
        foreach(output zero oversized maximum stype pnext)
            add_test(NAME agc_pipeline_binary_store_${query}_${output} COMMAND agc_pipeline_binary_store_tests --${query}-${output})
            set_tests_properties(agc_pipeline_binary_store_${query}_${output} PROPERTIES TIMEOUT 25)
            if(WIN32)
                set_tests_properties(agc_pipeline_binary_store_${query}_${output} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
    add_test(NAME agc_pipeline_binary_store_global_guard COMMAND agc_pipeline_binary_store_tests --global-guard)
    set_tests_properties(agc_pipeline_binary_store_global_guard PROPERTIES TIMEOUT 25)
    if(WIN32)
        set_tests_properties(agc_pipeline_binary_store_global_guard PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
    if(WIN32)
        set_tests_properties(agc_pipeline_binary_store PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
