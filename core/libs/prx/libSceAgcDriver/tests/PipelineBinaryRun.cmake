string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/pipeline-binary-${suffix}")
foreach(pass capture restore corrupt)
    if(pass STREQUAL "corrupt")
        file(GLOB stores "${root}/driver/binaries/*.bin")
        foreach(store IN LISTS stores)
            file(WRITE "${store}" "truncated")
        endforeach()
    endif()
    execute_process(COMMAND "${TEST}" --pipeline-binary-only "${root}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
    message("${pass}: ${output}${errors}")
    if(result EQUAL 77)
        file(REMOVE_RECURSE "${root}")
        message("skipped, no usable Vulkan device or the device lacks VK_KHR_pipeline_binary")
        return()
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${pass} failed: ${result}")
    endif()
    if("${output}${errors}" MATCHES "VUID-")
        message(FATAL_ERROR "${pass} added Vulkan validation errors")
    endif()
    if(pass STREQUAL "restore")
        string(REGEX MATCHALL "\\[pipeline-binary\\] loaded" loads "${errors}")
        list(LENGTH loads count)
        if(NOT count EQUAL 2 OR errors MATCHES "\\[pipeline-binary\\] built")
            message(FATAL_ERROR "the new process did not restore both pipelines")
        endif()
    else()
        string(REGEX MATCHALL "\\[pipeline-binary\\] saved" saves "${errors}")
        list(LENGTH saves count)
        if(NOT count EQUAL 2)
            message(FATAL_ERROR "${pass} did not persist both pipelines")
        endif()
    endif()
endforeach()
file(REMOVE_RECURSE "${root}")
