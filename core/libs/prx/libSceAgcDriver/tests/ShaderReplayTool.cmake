foreach(variable TOOL CAPTURE)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "${variable} is not set")
    endif()
endforeach()

execute_process(COMMAND "${TOOL}" --prepare "${CAPTURE}/invalid.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "prepared: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "preparation of the synthetic request failed: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --materialize "${CAPTURE}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "materialized: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "inactive image replay failed: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --materialize "${CAPTURE}/invalid.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "1" OR NOT output MATCHES "capture failed: runtime image descriptor is invalid")
    message(FATAL_ERROR "active invalid image replay did not fail at capture: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --materialize "${CAPTURE}/invalid.req" "${CAPTURE}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "1" OR NOT output MATCHES "capture failed: runtime image descriptor is invalid" OR NOT output MATCHES "materialized: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "replay did not continue after a failed request: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --maintenance8 --materialize "${CAPTURE}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "materialized: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "prepared replay with maintenance8 failed: ${code}\n${output}${errors}")
endif()

foreach(mode IN ITEMS --prepare --materialize)
    execute_process(COMMAND "${TOOL}" ${mode} "${CAPTURE}/lds.req" RESULT_VARIABLE code OUTPUT_VARIABLE baseline ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0" OR NOT baseline MATCHES "prepared: [0-9]+ SPIR-V words")
        message(FATAL_ERROR "${mode} of the LDS request failed: ${code}\n${baseline}${errors}")
    endif()
    execute_process(COMMAND "${TOOL}" ${mode} --wave-lds-memory-barriers "${CAPTURE}/lds.req" RESULT_VARIABLE code OUTPUT_VARIABLE overridden ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0" OR NOT overridden MATCHES "prepared: [0-9]+ SPIR-V words")
        message(FATAL_ERROR "${mode} --wave-lds-memory-barriers of the LDS request failed: ${code}\n${overridden}${errors}")
    endif()
    if(baseline STREQUAL overridden)
        message(FATAL_ERROR "${mode} ignored --wave-lds-memory-barriers\n${baseline}")
    endif()
endforeach()

function(expect_heap_profile description profile)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0" OR NOT output MATCHES "heap profile ${profile}\n")
        message(FATAL_ERROR "${description}: expected heap profile ${profile}: ${code}\n${output}${errors}")
    endif()
endfunction()

expect_heap_profile("captured heap off" "\\(captured\\): no heap, gpuResolvedImages 0, descriptorMemory 0, data uniform dwords 0" "${CAPTURE}/lds.req")
expect_heap_profile("captured heap with limit 0" "\\(captured\\): heap, gpuResolvedImages 1, descriptorMemory 1, data uniform dwords 0" "${CAPTURE}/heap-addressed.req")
expect_heap_profile("captured heap with limit 4096" "\\(captured\\): heap, gpuResolvedImages 1, descriptorMemory 1, data uniform dwords 4096" "${CAPTURE}/heap-4096.req")
expect_heap_profile("--gpu-heap on a heap-off capture" "\\(override\\): heap, gpuResolvedImages 1, descriptorMemory 1, data uniform dwords 16384" --gpu-heap "${CAPTURE}/lds.req")
expect_heap_profile("--gpu-heap on a limit 0 capture" "\\(override\\): heap, gpuResolvedImages 1, descriptorMemory 1, data uniform dwords 16384" --gpu-heap "${CAPTURE}/heap-addressed.req")
expect_heap_profile("--gpu-heap with a limit" "\\(override\\): heap, gpuResolvedImages 1, descriptorMemory 1, data uniform dwords 8192" --gpu-heap --heap-data-uniform-dwords 8192 "${CAPTURE}/lds.req")
expect_heap_profile("--no-gpu-heap on a heap capture" "\\(override\\): no heap, gpuResolvedImages 0, descriptorMemory 0, data uniform dwords 0" --no-gpu-heap "${CAPTURE}/heap-4096.req")
expect_heap_profile("--heap-data-uniform-dwords alone keeps the captured heap" "\\(override\\): heap, gpuResolvedImages 1, descriptorMemory 1, data uniform dwords 0" --heap-data-uniform-dwords 0 "${CAPTURE}/heap-4096.req")

execute_process(COMMAND "${TOOL}" --heap-data-uniform-dwords x "${CAPTURE}/lds.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "2")
    message(FATAL_ERROR "a malformed --heap-data-uniform-dwords value was accepted: ${code}\n${output}${errors}")
endif()

function(expect_usage_error description message)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT code STREQUAL "2" OR NOT errors MATCHES "${message}")
        message(FATAL_ERROR "${description}: expected exit 2 with '${message}': ${code}\n${output}${errors}")
    endif()
endfunction()

expect_usage_error("--gpu-heap then --no-gpu-heap" "--gpu-heap and --no-gpu-heap conflict" --gpu-heap --no-gpu-heap "${CAPTURE}/lds.req")
expect_usage_error("--no-gpu-heap then --gpu-heap" "--gpu-heap and --no-gpu-heap conflict" --no-gpu-heap --gpu-heap "${CAPTURE}/lds.req")
expect_usage_error("--no-gpu-heap with a limit" "--no-gpu-heap conflicts with --heap-data-uniform-dwords 4096" --no-gpu-heap --heap-data-uniform-dwords 4096 "${CAPTURE}/lds.req")
expect_usage_error("a limit then --no-gpu-heap" "--no-gpu-heap conflicts with --heap-data-uniform-dwords 4096" --heap-data-uniform-dwords 4096 --no-gpu-heap "${CAPTURE}/lds.req")
expect_usage_error("a missing limit" "needs an unsigned 32-bit number" --heap-data-uniform-dwords)
expect_usage_error("an overflowing limit" "needs an unsigned 32-bit number" --heap-data-uniform-dwords 99999999999 "${CAPTURE}/lds.req")
expect_usage_error("a negative limit" "needs an unsigned 32-bit number" --heap-data-uniform-dwords -1 "${CAPTURE}/lds.req")
expect_heap_profile("--no-gpu-heap with limit 0" "\\(override\\): no heap, gpuResolvedImages 0, descriptorMemory 0, data uniform dwords 0" --no-gpu-heap --heap-data-uniform-dwords 0 "${CAPTURE}/heap-4096.req")
expect_heap_profile("--gpu-heap replaces a captured limit" "\\(override\\): heap, gpuResolvedImages 1, descriptorMemory 1, data uniform dwords 16384" --gpu-heap "${CAPTURE}/heap-4096.req")

execute_process(COMMAND "${TOOL}" --robust2 --lds-lock-fences "${CAPTURE}/lds.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "target flags forced on: robust2, lds-lock-fences\n" OR NOT output MATCHES "heap profile \\(captured\\)")
    message(FATAL_ERROR "forced target flags were not reported next to the captured heap profile: ${code}\n${output}${errors}")
endif()

function(replay_spv result)
    execute_process(COMMAND "${TOOL}" --spv ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0" OR NOT output MATCHES "recompiled: [0-9]+ SPIR-V words")
        message(FATAL_ERROR "--spv ${ARGN} failed: ${code}\n${output}${errors}")
    endif()
    string(FIND "${output}" "\n" firstLine)
    math(EXPR firstLine "${firstLine} + 1")
    string(SUBSTRING "${output}" ${firstLine} -1 output)
    string(REGEX REPLACE "[^\n]*heap profile[^\n]*\n" "" output "${output}")
    set(${result} "${output}" PARENT_SCOPE)
endfunction()

replay_spv(addressed "${CAPTURE}/heap-data-addressed.req")
replay_spv(uniform "${CAPTURE}/heap-data-4096.req")
replay_spv(addressedAgain --heap-data-uniform-dwords 0 "${CAPTURE}/heap-data-addressed.req")
replay_spv(uniformOverride --heap-data-uniform-dwords 4096 "${CAPTURE}/heap-data-addressed.req")
replay_spv(addressedOverride --heap-data-uniform-dwords 0 "${CAPTURE}/heap-data-4096.req")
if(addressed STREQUAL uniform)
    message(FATAL_ERROR "the captured limits 0 and 4096 replayed to the same SPIR-V\n${addressed}")
endif()
if(NOT addressed STREQUAL addressedAgain OR NOT uniform STREQUAL uniformOverride OR NOT addressed STREQUAL addressedOverride)
    message(FATAL_ERROR "--heap-data-uniform-dwords did not reproduce the captured limit's SPIR-V\n${addressed}\n${addressedAgain}\n${uniform}\n${uniformOverride}\n${addressedOverride}")
endif()
