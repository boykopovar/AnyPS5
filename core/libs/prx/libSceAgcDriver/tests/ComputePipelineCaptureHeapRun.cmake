foreach(required IN ITEMS FIXTURE OUTPUT_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef runId)
set(runDirectory "${OUTPUT_ROOT}/compute-capture-heap-${runId}")
set(captureDirectory "${runDirectory}/captures")
file(MAKE_DIRECTORY "${runDirectory}")
execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env "ANYPS5_REQUIRE_VULKAN=1" "ANYPS5_NO_SHADER_CACHE=1" "APS5_GPU_HEAP=1" "APS5_PIPELINE_STATS=0" "APS5_DUMP_COMPUTE_PIPELINES=${captureDirectory}" "APS5_DUMP_COMPUTE_MIN_WORDS=0" "${FIXTURE}"
        WORKING_DIRECTORY "${runDirectory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20
)
file(WRITE "${runDirectory}/heap.log" "${output}\n${error}")
if(result STREQUAL "77")
    message(STATUS "compute pipeline heap capture run: skipped, no usable Vulkan device")
    file(REMOVE_RECURSE "${runDirectory}")
    return()
endif()
if(NOT result STREQUAL "0" OR NOT output MATCHES "compute stages sampled their textures through the heap")
    message(FATAL_ERROR "Heap compute fixture failed: ${result}\n${output}\n${error}")
endif()
file(GLOB captures "${captureDirectory}/compute-*/capture.aps5cp")
list(LENGTH captures count)
if(NOT count EQUAL 0)
    message(FATAL_ERROR "Heap compute pipelines were captured, but a capture does not preserve their descriptor heap mappings: ${captures}")
endif()
message(STATUS "Heap compute fixture ran with no captured pipelines")
file(REMOVE_RECURSE "${runDirectory}")
