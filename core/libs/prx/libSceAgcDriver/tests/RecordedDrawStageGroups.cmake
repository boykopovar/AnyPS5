execute_process(COMMAND "${PROGRAM}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message("${output}${errors}")
if(result EQUAL 77)
    if("$ENV{ANYPS5_REQUIRE_VULKAN}" STREQUAL "1")
        message(FATAL_ERROR "recorded draw stage groups: required Vulkan unavailable")
    endif()
    message("recorded draw stage groups: Vulkan unavailable")
    return()
endif()
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "recorded draw fixture failed: ${result}")
endif()
string(REGEX MATCHALL "\\[drawstages\\][^\r\n]*" mappings "${output}${errors}")
set(found FALSE)
foreach(mapping IN LISTS mappings)
    if(mapping MATCHES "drawset (0x[0-9a-fA-F]+) 1:(0x[0-9a-fA-F]+) 5:(0x[0-9a-fA-F]+)$")
        set(drawset "${CMAKE_MATCH_1}")
        set(vertex "${CMAKE_MATCH_2}")
        set(fragment "${CMAKE_MATCH_3}")
        if(DEFINED vertex_${fragment} AND NOT "${vertex_${fragment}}" STREQUAL "${vertex}" AND
                NOT "${drawset_${fragment}}" STREQUAL "${drawset}")
            set(found TRUE)
        endif()
        set(vertex_${fragment} "${vertex}")
        set(drawset_${fragment} "${drawset}")
    endif()
endforeach()
if(NOT found)
    message(FATAL_ERROR "recorded draws did not distinguish vertex variants sharing a fragment variant")
endif()
message("recorded draw stage groups: distinct vertex variants sharing a fragment remain separate")
