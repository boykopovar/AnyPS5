# Runs run_report_revision.cmake against throwaway repositories and checks the modified flag it writes.
# Usage: cmake -DGIT=<git> -DSCRIPT=<run_report_revision.cmake> -DWORK=<empty folder> -P tests_run_report_revision.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(failures 0)
set(cases 0)

function(git folder)
    execute_process(COMMAND "${GIT}" -c user.name=t -c user.email=t@t -c protocol.file.allow=always -C "${folder}" ${ARGN}
            RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "git ${ARGN} failed in ${folder}: ${err}")
    endif()
endfunction()

function(expect name folder expected)
    set(out "${WORK}/${name}.hpp")
    execute_process(COMMAND ${CMAKE_COMMAND} -DGIT=${GIT} -DSOURCE=${folder} -DOUTPUT=${out} -P "${SCRIPT}" RESULT_VARIABLE rc)
    file(READ "${out}" text)
    math(EXPR cases "${cases} + 1")
    set(cases ${cases} PARENT_SCOPE)
    if(text MATCHES "APS5_REPORT_MODIFIED ${expected}\n")
        message(STATUS "PASS ${name}")
    else()
        message(STATUS "FAIL ${name}: expected modified ${expected}, wrote: ${text}")
        math(EXPR failures "${failures} + 1")
        set(failures ${failures} PARENT_SCOPE)
    endif()
endfunction()

set(sub "${WORK}/sub")
file(MAKE_DIRECTORY "${sub}")
git("${sub}" init -q)
file(WRITE "${sub}/lib.txt" "one\n")
git("${sub}" add lib.txt)
git("${sub}" commit -q -m sub)

set(repo "${WORK}/repo")
file(MAKE_DIRECTORY "${repo}")
git("${repo}" init -q)
file(WRITE "${repo}/source.cpp" "int main() {}\n")
git("${repo}" add source.cpp)
git("${repo}" commit -q -m base)
git("${repo}" submodule add -q "${sub}" third)
git("${repo}" commit -q -m submodule)

expect(clean "${repo}" 0)
file(WRITE "${repo}/new_source.cpp" "int extra;\n")
expect(untracked-source "${repo}" 1)
file(REMOVE "${repo}/new_source.cpp")
expect(clean-again "${repo}" 0)
file(APPEND "${repo}/source.cpp" "// edit\n")
expect(tracked-edit "${repo}" 1)
git("${repo}" checkout -q source.cpp)
file(APPEND "${repo}/third/lib.txt" "two\n")
expect(submodule-edit "${repo}" 1)
git("${repo}/third" checkout -q lib.txt)
file(WRITE "${repo}/third/stray.txt" "x\n")
expect(submodule-untracked "${repo}" 1)
file(REMOVE "${repo}/third/stray.txt")
expect(submodule-clean "${repo}" 0)
# The build folder of a CI checkout sits inside the repository, so git would find it from here: git stops the search below a ceiling.
get_filename_component(workParent "${WORK}" DIRECTORY)
set(ENV{GIT_CEILING_DIRECTORIES} "${workParent}")
expect(not-a-repo "${WORK}" -1)
unset(ENV{GIT_CEILING_DIRECTORIES})

message(STATUS "revision cases: ${cases}, failed: ${failures}")
if(cases EQUAL 0 OR failures GREATER 0)
    message(FATAL_ERROR "run_report_revision test failed")
endif()
