if(BUILD_TESTING AND WIN32)
    add_test_executable(windows_read_trap_tests ${LIBS_INCLUDE_DIR}/tests/WindowsReadTraps.cpp)
    target_include_directories(windows_read_trap_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_compile_features(windows_read_trap_tests PRIVATE cxx_std_20)
    target_link_libraries(windows_read_trap_tests PRIVATE libc)
    set_target_properties(windows_read_trap_tests PROPERTIES CXX_EXTENSIONS OFF)
    configure_windows_unwind(windows_read_trap_tests)
    foreach(mode trap release host unknown reset alias trapped generation untrapped holder threads)
        add_test(NAME windows_read_trap_${mode} COMMAND windows_read_trap_tests ${mode})
        set_tests_properties(windows_read_trap_${mode} PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77 ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endforeach()
endif()
