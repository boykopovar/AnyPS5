if(BUILD_TESTING)
    add_test_executable(guest_stream_status_pushback_tests ${LIBS_INCLUDE_DIR}/tests/GuestStreamStatusPushback.cpp)
    target_include_directories(guest_stream_status_pushback_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_stream_status_pushback_tests PRIVATE libc)
    configure_windows_unwind(guest_stream_status_pushback_tests)
    foreach(operation IN ITEMS feof ferror feof_unlocked ferror_unlocked clearerr clearerr_unlocked)
        add_test(NAME guest_stream_status_pushback_${operation} COMMAND guest_stream_status_pushback_tests ${operation})
        set_tests_properties(guest_stream_status_pushback_${operation} PROPERTIES TIMEOUT 10)
        if(WIN32)
            set_tests_properties(guest_stream_status_pushback_${operation} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
