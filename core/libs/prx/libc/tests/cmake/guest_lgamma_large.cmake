    add_test(NAME guest_lgamma_large COMMAND guest_lgamma_large_tests)
    set_tests_properties(guest_lgamma_large PROPERTIES TIMEOUT 30)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
