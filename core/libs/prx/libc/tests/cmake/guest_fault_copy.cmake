if((CMAKE_SYSTEM_NAME STREQUAL "Linux" OR APPLE) AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    add_test_executable(guest_fault_copy_tests ${LIBS_INCLUDE_DIR}/tests/GuestFaultCopy.cpp)
    target_include_directories(guest_fault_copy_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_fault_copy_tests PRIVATE libkernel libc)
    add_test(NAME guest_fault_copy COMMAND guest_fault_copy_tests)
    set(guest_fault_copy_registrations guest_fault_copy)
    if(NOT APPLE)
        add_test(NAME guest_fault_copy_syscall COMMAND guest_fault_copy_tests)
        set_tests_properties(guest_fault_copy_syscall PROPERTIES ENVIRONMENT "APS5_GUEST_COPY_SYSCALL=1")
        list(APPEND guest_fault_copy_registrations guest_fault_copy_syscall)
    endif()
    set_tests_properties(${guest_fault_copy_registrations} PROPERTIES TIMEOUT 20)
    foreach(test ${guest_fault_copy_registrations})
        add_asan_test_options(${test} handle_segv=0:handle_sigbus=0)
    endforeach()
endif()
