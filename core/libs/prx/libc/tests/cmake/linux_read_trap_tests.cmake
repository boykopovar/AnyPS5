if(BUILD_TESTING AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(Threads REQUIRED)
    add_test_executable(linux_read_trap_tests ${LIBS_INCLUDE_DIR}/tests/LinuxReadTraps.cpp ${CMAKE_CURRENT_SOURCE_DIR}/src/GuestWriteWatch.cpp)
    target_include_directories(linux_read_trap_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_compile_features(linux_read_trap_tests PRIVATE cxx_std_20)
    target_link_libraries(linux_read_trap_tests PRIVATE Threads::Threads)
    set_target_properties(linux_read_trap_tests PROPERTIES CXX_EXTENSIONS OFF)
    foreach(mode trap release protect host unknown unregister threads holder trapped)
        add_test(NAME linux_read_trap_${mode} COMMAND linux_read_trap_tests ${mode})
        set_tests_properties(linux_read_trap_${mode} PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77)
    endforeach()
endif()
