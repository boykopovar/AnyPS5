if(BUILD_TESTING AND Python3_Interpreter_FOUND)
    add_test_executable(libc_runtime_assertion_tests tests/RuntimeAssertion.cpp)
    target_include_directories(libc_runtime_assertion_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(libc_runtime_assertion_tests PRIVATE libc)
    configure_windows_unwind(libc_runtime_assertion_tests)
