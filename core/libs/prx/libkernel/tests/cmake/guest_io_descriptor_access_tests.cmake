if(BUILD_TESTING)
    add_test_executable(guest_io_descriptor_access_tests ${LIBS_INCLUDE_DIR}/tests/GuestIoDescriptorAccess.cpp)
    target_include_directories(guest_io_descriptor_access_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_io_descriptor_access_tests PRIVATE libkernel libc libSceNet)
    configure_windows_unwind(guest_io_descriptor_access_tests)
    foreach(closeTransport 0 1)
        set(closeTest guest_io_close_sce_${closeTransport})
        add_test(NAME ${closeTest} COMMAND guest_io_descriptor_access_tests posix_close ${closeTransport} 0 0 2)
        set_tests_properties(${closeTest} PROPERTIES TIMEOUT 15)
        if(WIN32)
            set_tests_properties(${closeTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        endif()
        foreach(closeCase close_unregistered close_readers)
            set(closeTest guest_io_${closeCase}_${closeTransport})
            add_test(NAME ${closeTest} COMMAND guest_io_descriptor_access_tests ${closeCase} ${closeTransport})
            set_tests_properties(${closeTest} PROPERTIES TIMEOUT 15)
            if(WIN32)
                set_tests_properties(${closeTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
            endif()
        endforeach()
        foreach(closeApi 0 1 2 3 4)
            if(closeTransport EQUAL 0 AND closeApi GREATER 1)
                continue()
            endif()
            foreach(closeDisabled 0 1)
                set(closeTest guest_io_close_${closeTransport}_${closeApi}_${closeDisabled})
                add_test(NAME ${closeTest} COMMAND guest_io_descriptor_access_tests posix_close ${closeTransport} ${closeApi} ${closeDisabled} 0)
                set_tests_properties(${closeTest} PROPERTIES TIMEOUT 15)
                if(WIN32)
                    set_tests_properties(${closeTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
                endif()
            endforeach()
        endforeach()
    endforeach()
    add_test(NAME guest_io_close_socket_direct COMMAND guest_io_descriptor_access_tests posix_close 1 2 0 1)
    set_tests_properties(guest_io_close_socket_direct PROPERTIES TIMEOUT 15)
    if(WIN32)
        set_tests_properties(guest_io_close_socket_direct PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        add_test(NAME guest_io_close_native_errors COMMAND guest_io_descriptor_access_tests close_native_errors)
        set_tests_properties(guest_io_close_native_errors PROPERTIES TIMEOUT 15 ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
    endif()
    foreach(descriptorCase registry_lifetime close_before_native)
        add_test(NAME guest_io_descriptor_${descriptorCase} COMMAND guest_io_descriptor_access_tests ${descriptorCase})
        set_tests_properties(guest_io_descriptor_${descriptorCase} PROPERTIES TIMEOUT 15)
        if(WIN32)
            set_tests_properties(guest_io_descriptor_${descriptorCase} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        endif()
    endforeach()
    add_test(NAME guest_io_descriptor_capacity COMMAND guest_io_descriptor_access_tests capacity)
    add_test(NAME guest_io_descriptor_no_aliases COMMAND guest_io_descriptor_access_tests no_aliases)
    add_test(NAME guest_io_descriptor_access_cancel COMMAND guest_io_descriptor_access_tests access_cancel)
    add_test(NAME guest_io_descriptor_protected_close COMMAND guest_io_descriptor_access_tests protected_close)
    add_test(NAME guest_io_descriptor_invalid_duplicate COMMAND guest_io_descriptor_access_tests invalid_duplicate)
    set_tests_properties(guest_io_descriptor_invalid_duplicate PROPERTIES TIMEOUT 15)
    if(WIN32)
        set_tests_properties(guest_io_descriptor_invalid_duplicate PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
    endif()
    add_test(NAME guest_io_descriptor_stdio_close COMMAND guest_io_descriptor_access_tests stdio_close)
    add_test(NAME guest_io_descriptor_stdio_reopen COMMAND guest_io_descriptor_access_tests stdio_reopen)
    set_tests_properties(guest_io_descriptor_capacity guest_io_descriptor_no_aliases guest_io_descriptor_access_cancel guest_io_descriptor_protected_close guest_io_descriptor_stdio_close guest_io_descriptor_stdio_reopen PROPERTIES TIMEOUT 15)
    if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_test(NAME guest_io_descriptor_borrowed_recv_close COMMAND guest_io_descriptor_access_tests borrowed_recv_close)
        add_test(NAME guest_io_descriptor_borrowed_recvfrom_close COMMAND guest_io_descriptor_access_tests borrowed_recvfrom_close)
        set_tests_properties(guest_io_descriptor_borrowed_recv_close guest_io_descriptor_borrowed_recvfrom_close PROPERTIES TIMEOUT 15)
    endif()
    if(WIN32)
        add_test(NAME guest_io_descriptor_close_progress COMMAND guest_io_descriptor_access_tests close_progress)
        add_test(NAME guest_io_descriptor_position_cancel COMMAND guest_io_descriptor_access_tests position_cancel)
        add_test(NAME guest_io_descriptor_position_release COMMAND guest_io_descriptor_access_tests position_release)
        add_test(NAME guest_io_descriptor_pipe_vectors COMMAND guest_io_descriptor_access_tests pipe_vectors)
        add_test(NAME guest_io_descriptor_append_status COMMAND guest_io_descriptor_access_tests append_status)
        add_test(NAME guest_io_descriptor_append_stream COMMAND guest_io_descriptor_access_tests append_stream)
        set_tests_properties(guest_io_descriptor_append_status guest_io_descriptor_append_stream PROPERTIES TIMEOUT 15 ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        set_tests_properties(guest_io_descriptor_close_progress guest_io_descriptor_position_cancel guest_io_descriptor_position_release guest_io_descriptor_pipe_vectors PROPERTIES TIMEOUT 15)
        set_tests_properties(guest_io_descriptor_capacity guest_io_descriptor_no_aliases guest_io_descriptor_access_cancel guest_io_descriptor_close_progress guest_io_descriptor_position_cancel guest_io_descriptor_position_release guest_io_descriptor_pipe_vectors guest_io_descriptor_protected_close guest_io_descriptor_stdio_close guest_io_descriptor_stdio_reopen PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        set_tests_properties(guest_io_descriptor_borrowed_recv_close guest_io_descriptor_borrowed_recvfrom_close PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
    else()
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            add_test(NAME guest_io_descriptor_invalid_registry COMMAND guest_io_descriptor_access_tests invalid_registry)
            set_tests_properties(guest_io_descriptor_invalid_registry PROPERTIES TIMEOUT 15)
        endif()
        add_test(NAME guest_io_descriptor_record_locks COMMAND guest_io_descriptor_access_tests record_locks)
        add_test(NAME guest_io_descriptor_borrowed_net_close COMMAND guest_io_descriptor_access_tests borrowed_net_close)
        add_test(NAME guest_io_descriptor_borrowed_posix_close COMMAND guest_io_descriptor_access_tests borrowed_posix_close)
        set_tests_properties(guest_io_descriptor_borrowed_posix_close PROPERTIES TIMEOUT 15)
        set_tests_properties(guest_io_descriptor_record_locks guest_io_descriptor_borrowed_net_close PROPERTIES TIMEOUT 15)
    endif()
endif()
