if(BUILD_TESTING)
    if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_test_executable(guest_io_read_shutdown_tests ${LIBS_INCLUDE_DIR}/tests/GuestIoReadShutdown.cpp)
        target_include_directories(guest_io_read_shutdown_tests PRIVATE ${LIBS_INCLUDE_DIR})
        target_link_libraries(guest_io_read_shutdown_tests PRIVATE libkernel libc)
        configure_windows_unwind(guest_io_read_shutdown_tests)
        foreach(shutdownNetwork stream datagram)
            foreach(shutdownApi read alias readv readv_alias recv recvfrom recvfrom_alias recvmsg recvmsg_alias sce_read sce_readv)
                foreach(shutdownMode shutdown alias parallel disabled native timeout cancel waitall reuse accept)
                    if(shutdownMode STREQUAL "accept" AND (NOT shutdownNetwork STREQUAL "stream" OR NOT shutdownApi STREQUAL "recv"))
                        continue()
                    endif()
                    if(shutdownMode STREQUAL "reuse" AND NOT shutdownApi MATCHES "^sce_")
                        continue()
                    endif()
                    if(shutdownApi MATCHES "^sce_" AND shutdownMode MATCHES "^(disabled|cancel|waitall)$")
                        continue()
                    endif()
                    if(shutdownMode STREQUAL "waitall" AND (shutdownNetwork STREQUAL "datagram" OR NOT shutdownApi MATCHES "^recv"))
                        continue()
                    endif()
                    set(shutdownTest guest_io_read_shutdown_${shutdownNetwork}_${shutdownApi}_${shutdownMode})
                    add_test(NAME ${shutdownTest} COMMAND guest_io_read_shutdown_tests ${shutdownNetwork} ${shutdownApi} ${shutdownMode})
                    set_tests_properties(${shutdownTest} PROPERTIES TIMEOUT 15)
                    if(WIN32)
                        set_tests_properties(${shutdownTest} PROPERTIES ENVIRONMENT_MODIFICATION
                            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endif()
endif()
