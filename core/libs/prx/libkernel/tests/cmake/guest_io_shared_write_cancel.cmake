if(BUILD_TESTING AND (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux"))
    add_test_executable(guest_io_shared_write_cancel_tests ${LIBS_INCLUDE_DIR}/tests/GuestIoSharedWriteCancel.cpp)
    target_include_directories(guest_io_shared_write_cancel_tests PRIVATE ${LIBS_INCLUDE_DIR} ${LIBS_INCLUDE_DIR}/nid/include)
    target_link_libraries(guest_io_shared_write_cancel_tests PRIVATE libkernel_sys libkernel libc)
    configure_windows_unwind(guest_io_shared_write_cancel_tests)
    foreach(sharedWriteApi write alias writev writev_alias pwrite pwrite_sys pwritev)
        foreach(sharedWriteScenario cancel complete disabled close disabled_close)
            set(sharedWriteTest guest_io_write_shared_${sharedWriteApi}__${sharedWriteScenario})
            add_test(NAME ${sharedWriteTest} COMMAND guest_io_shared_write_cancel_tests ${sharedWriteApi} ${sharedWriteScenario})
            set_tests_properties(${sharedWriteTest} PROPERTIES TIMEOUT 15)
            if(WIN32)
                set_tests_properties(${sharedWriteTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
            endif()
        endforeach()
    endforeach()
endif()
