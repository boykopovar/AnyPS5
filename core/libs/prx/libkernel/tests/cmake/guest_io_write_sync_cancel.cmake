if(BUILD_TESTING)
    add_test_executable(guest_io_write_sync_cancel_tests ${LIBS_INCLUDE_DIR}/tests/GuestIoWriteSyncCancel.cpp)
    target_include_directories(guest_io_write_sync_cancel_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_io_write_sync_cancel_tests PRIVATE libkernel_sys libkernel libc)
    configure_windows_unwind(guest_io_write_sync_cancel_tests)
    foreach(syncWriteApi write writev pwrite pwrite_sys pwritev)
        foreach(syncWriteCase cancel disabled complete zero error close signal metadata_cancel metadata_disabled metadata_complete metadata_close metadata_signal gap_signal gap_complete metadata_gap_signal metadata_gap_complete flush_error_signal flush_error_complete)
            set(syncWriteTest guest_io_write_sync_${syncWriteApi}__${syncWriteCase})
            add_test(NAME ${syncWriteTest} COMMAND guest_io_write_sync_cancel_tests ${syncWriteApi} ${syncWriteCase})
            set_tests_properties(${syncWriteTest} PROPERTIES TIMEOUT 15)
            if(WIN32)
                set_tests_properties(${syncWriteTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
            endif()
        endforeach()
    endforeach()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        foreach(preflightApi write writev pwrite pwrite_sys pwritev)
            foreach(preflightPhase 1 2)
                foreach(preflightCase cancel disabled complete close signal)
                    set(preflightTest guest_io_write_preflight_${preflightApi}__${preflightPhase}_${preflightCase})
                    add_test(NAME ${preflightTest} COMMAND guest_io_write_sync_cancel_tests ${preflightApi} preflight${preflightPhase}_${preflightCase})
                    set_tests_properties(${preflightTest} PROPERTIES TIMEOUT 15)
                endforeach()
            endforeach()
        endforeach()
    endif()
    add_test(NAME guest_io_write_sync_sce COMMAND guest_io_write_sync_cancel_tests sce cancel)
    add_test(NAME guest_io_write_sync_sce_legacy COMMAND guest_io_write_sync_cancel_tests sce legacy)
    set_tests_properties(guest_io_write_sync_sce PROPERTIES TIMEOUT 15)
    set_tests_properties(guest_io_write_sync_sce_legacy PROPERTIES TIMEOUT 15)
    if(WIN32)
        set_tests_properties(guest_io_write_sync_sce PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        set_tests_properties(guest_io_write_sync_sce_legacy PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
    endif()
endif()
