if(BUILD_TESTING)
    add_test_executable(guest_io_write_cancel_tests ${LIBS_INCLUDE_DIR}/tests/GuestIoWriteCancel.cpp)
    target_include_directories(guest_io_write_cancel_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_io_write_cancel_tests PRIVATE libkernel_sys libkernel libc)
    configure_windows_unwind(guest_io_write_cancel_tests)
    foreach(writeTransport pipe loopback regular datagram)
        set(writeApis write alias writev writev_alias)
        set(writeScenarios cancel disabled complete zero partial pending nonblocking close reuse alias_close peer_close race)
        if(writeTransport STREQUAL "pipe")
            list(APPEND writeScenarios atomic signal_close)
        elseif(writeTransport STREQUAL "loopback")
            list(APPEND writeApis send sendto sendto_alias sendmsg sendmsg_alias)
            list(APPEND writeScenarios timeout)
        elseif(writeTransport STREQUAL "datagram")
            list(APPEND writeApis send sendto sendto_alias sendmsg sendmsg_alias)
            set(writeScenarios complete zero pending pending_zero)
        elseif(writeTransport STREQUAL "regular")
            list(APPEND writeApis pwrite pwrite_sys pwritev)
            set(writeScenarios complete zero pending access append)
            if(WIN32)
                list(APPEND writeScenarios position)
            endif()
        endif()
        foreach(writeApi IN LISTS writeApis)
            set(writeCases ${writeScenarios})
            if(writeTransport STREQUAL "loopback" AND writeApi MATCHES "^send")
                list(APPEND writeCases dontwait)
            endif()
            foreach(writeScenario IN LISTS writeCases)
                set(writeTest guest_io_write_${writeTransport}__${writeApi}__${writeScenario})
                add_test(NAME ${writeTest} COMMAND guest_io_write_cancel_tests ${writeTransport} ${writeApi} ${writeScenario})
                set_tests_properties(${writeTest} PROPERTIES TIMEOUT 15)
                if(WIN32)
                    set_tests_properties(${writeTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
                endif()
            endforeach()
        endforeach()
    endforeach()
    foreach(writeApi sce_write sce_writev)
        foreach(writeTransport pipe loopback)
            set(writeTest guest_io_write_${writeTransport}_${writeApi})
            add_test(NAME ${writeTest} COMMAND guest_io_write_cancel_tests ${writeTransport} ${writeApi} disabled)
            set_tests_properties(${writeTest} PROPERTIES TIMEOUT 15)
            if(WIN32)
                set_tests_properties(${writeTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
            endif()
        endforeach()
    endforeach()
endif()
