if(BUILD_TESTING)
    add_test_executable(guest_io_read_cancel_tests ${LIBS_INCLUDE_DIR}/tests/GuestIoReadCancel.cpp)
    target_include_directories(guest_io_read_cancel_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_io_read_cancel_tests PRIVATE libkernel libc)
    configure_windows_unwind(guest_io_read_cancel_tests)
    foreach(ioReadTransport pipe loopback datagram)
        if(ioReadTransport STREQUAL "pipe")
            set(ioReadApis read alias readv)
        else()
            set(ioReadApis read alias readv recv recvfrom recvmsg)
        endif()
        foreach(ioReadApi IN LISTS ioReadApis)
            foreach(ioReadScenario cancel complete disabled pending reuse reuse_complete partial race)
                set(ioReadTest guest_io_read_${ioReadTransport}_${ioReadApi}_${ioReadScenario})
                add_test(NAME ${ioReadTest} COMMAND guest_io_read_cancel_tests ${ioReadTransport} ${ioReadApi} ${ioReadScenario})
                set_tests_properties(${ioReadTest} PROPERTIES TIMEOUT 15)
                if(WIN32)
                    set_tests_properties(${ioReadTest} PROPERTIES ENVIRONMENT_MODIFICATION
                        "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
                endif()
            endforeach()
        endforeach()
    endforeach()
    foreach(ioReadPositionedApi pread preadv)
        add_test(NAME guest_io_read_pending_${ioReadPositionedApi} COMMAND guest_io_read_cancel_tests pipe ${ioReadPositionedApi} pending)
        set_tests_properties(guest_io_read_pending_${ioReadPositionedApi} PROPERTIES TIMEOUT 15)
        if(WIN32)
            set_tests_properties(guest_io_read_pending_${ioReadPositionedApi} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        endif()
    endforeach()
    foreach(ioReadZeroApi recvmsg_empty recvmsg_zero)
        foreach(ioReadZeroCase cancel complete disabled pending dontwait eof)
            set(ioReadZeroTest guest_io_read_zero_${ioReadZeroApi}_${ioReadZeroCase})
            add_test(NAME ${ioReadZeroTest} COMMAND guest_io_read_cancel_tests loopback ${ioReadZeroApi} ${ioReadZeroCase})
            set_tests_properties(${ioReadZeroTest} PROPERTIES TIMEOUT 15)
            if(WIN32)
                set_tests_properties(${ioReadZeroTest} PROPERTIES ENVIRONMENT_MODIFICATION
                    "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
            endif()
        endforeach()
    endforeach()
    foreach(ioReadErrorTransport loopback datagram)
        foreach(ioReadErrorApi read recv recvfrom recvmsg)
            foreach(ioReadErrorCase timeout nonblocking dontwait)
                if(ioReadErrorApi STREQUAL "read" AND ioReadErrorCase STREQUAL "dontwait")
                    continue()
                endif()
                set(ioReadErrorTest guest_io_read_${ioReadErrorTransport}_${ioReadErrorApi}_${ioReadErrorCase})
                add_test(NAME ${ioReadErrorTest} COMMAND guest_io_read_cancel_tests ${ioReadErrorTransport} ${ioReadErrorApi} ${ioReadErrorCase})
                set_tests_properties(${ioReadErrorTest} PROPERTIES TIMEOUT 15)
                if(WIN32)
                    set_tests_properties(${ioReadErrorTest} PROPERTIES ENVIRONMENT_MODIFICATION
                        "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
                endif()
            endforeach()
        endforeach()
    endforeach()
    foreach(ioReadWaitAllApi recv recvfrom recvmsg)
        set(ioReadWaitAllTest guest_io_read_waitall_${ioReadWaitAllApi})
        add_test(NAME ${ioReadWaitAllTest} COMMAND guest_io_read_cancel_tests loopback ${ioReadWaitAllApi} waitall)
        set_tests_properties(${ioReadWaitAllTest} PROPERTIES TIMEOUT 15)
        if(WIN32)
            set_tests_properties(${ioReadWaitAllTest} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        endif()
    endforeach()
    foreach(ioReadSceTransport pipe loopback datagram)
        foreach(ioReadSceApi sce_read sce_readv)
            set(ioReadSceTest guest_io_read_${ioReadSceTransport}_${ioReadSceApi})
            add_test(NAME ${ioReadSceTest} COMMAND guest_io_read_cancel_tests ${ioReadSceTransport} ${ioReadSceApi} cancel)
            set_tests_properties(${ioReadSceTest} PROPERTIES TIMEOUT 15)
            if(WIN32)
                set_tests_properties(${ioReadSceTest} PROPERTIES ENVIRONMENT_MODIFICATION
                    "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
            endif()
        endforeach()
    endforeach()
endif()
