if(BUILD_TESTING)
    add_test_executable(guest_io_context_tests ${LIBS_INCLUDE_DIR}/tests/GuestIoContext.cpp)
    target_include_directories(guest_io_context_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_io_context_tests PRIVATE libSceLibcInternal libkernel libc)
    configure_windows_unwind(guest_io_context_tests)
    if(WIN32)
        add_test(NAME guest_io_context_deferred_drain COMMAND guest_io_context_tests deferred_drain)
        set_tests_properties(guest_io_context_deferred_drain PROPERTIES TIMEOUT 15
            ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
    endif()
    foreach(ioContext underscorejump manual_underscorejump adopted adopted_exit swap jump sigjump manual_swap manual_jump manual_sigjump manual_leave manual_sigleave)
        add_test(NAME guest_io_context_${ioContext} COMMAND guest_io_context_tests ${ioContext})
        set_tests_properties(guest_io_context_${ioContext} PROPERTIES TIMEOUT 15)
        if(WIN32)
            set_tests_properties(guest_io_context_${ioContext} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        endif()
    endforeach()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_test(NAME guest_io_context_churn COMMAND guest_io_context_tests churn)
        set_tests_properties(guest_io_context_churn PROPERTIES TIMEOUT 15)
    endif()
endif()
