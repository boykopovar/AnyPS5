function(check_python_tool_test_names)
    get_property(registration_names DIRECTORY PROPERTY ANYPS5_PYTHON_TOOL_TEST_NAMES)
    set(registration_directories "${CMAKE_CURRENT_SOURCE_DIR}")
    set(registration_seen_names)
    while(registration_directories)
        list(POP_FRONT registration_directories registration_directory)
        get_property(registration_children DIRECTORY "${registration_directory}" PROPERTY SUBDIRECTORIES)
        list(APPEND registration_directories ${registration_children})
        get_property(registration_tests DIRECTORY "${registration_directory}" PROPERTY TESTS)
        foreach(registration_name IN LISTS registration_tests)
            if(registration_name IN_LIST registration_names)
                if(registration_name IN_LIST registration_seen_names)
                    message(FATAL_ERROR "Python tool test registration duplicates test across directories: ${registration_name} (${registration_directory})")
                endif()
                list(APPEND registration_seen_names "${registration_name}")
            endif()
        endforeach()
    endwhile()
endfunction()

function(register_python_tool_tests source_root)
    set(registration_validator "${source_root}/cmake/tool_test_registration.py")
    file(GLOB registration_files CONFIGURE_DEPENDS "${source_root}/tools/tests/registrations/*.json")
    list(SORT registration_files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${registration_validator}" ${registration_files})
    execute_process(
        COMMAND "${Python3_EXECUTABLE}" "${registration_validator}" "${source_root}"
        RESULT_VARIABLE registration_result
        OUTPUT_VARIABLE registration_json
        ERROR_VARIABLE registration_error
        TIMEOUT 30
    )
    if(NOT registration_result STREQUAL "0")
        message(FATAL_ERROR "Python tool test registration failed (${registration_result}): ${registration_error}")
    endif()
    string(JSON registration_count LENGTH "${registration_json}" tests)
    if(registration_count EQUAL 0)
        return()
    endif()
    math(EXPR registration_last "${registration_count} - 1")
    set(registration_names)
    foreach(registration_index RANGE ${registration_last})
        string(JSON registration_name GET "${registration_json}" tests ${registration_index} name)
        if(TEST "${registration_name}")
            message(FATAL_ERROR "Python tool test registration duplicates existing test: ${registration_name}")
        endif()
        list(APPEND registration_names "${registration_name}")
    endforeach()
    foreach(registration_index RANGE ${registration_last})
        string(JSON registration_name GET "${registration_json}" tests ${registration_index} name)
        string(JSON registration_script GET "${registration_json}" tests ${registration_index} script)
        string(JSON registration_timeout GET "${registration_json}" tests ${registration_index} timeout)
        string(JSON registration_argument_count LENGTH "${registration_json}" tests ${registration_index} arguments)
        set(registration_arguments)
        if(registration_argument_count GREATER 0)
            math(EXPR registration_argument_last "${registration_argument_count} - 1")
            foreach(registration_argument_index RANGE ${registration_argument_last})
                string(JSON registration_argument GET "${registration_json}" tests ${registration_index} arguments ${registration_argument_index})
                list(APPEND registration_arguments "${registration_argument}")
            endforeach()
        endif()
        add_test(NAME "${registration_name}" COMMAND "${Python3_EXECUTABLE}"
            "${source_root}/tools/tests/${registration_script}" ${registration_arguments})
        set_tests_properties("${registration_name}" PROPERTIES TIMEOUT "${registration_timeout}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY ANYPS5_PYTHON_TOOL_TEST_NAMES ${registration_names})
    cmake_language(DEFER CALL check_python_tool_test_names)
endfunction()
