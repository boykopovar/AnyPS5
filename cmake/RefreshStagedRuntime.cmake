get_filename_component(stagedName "${SOURCE}" NAME)
set(staged "${STAGED_DIR}/${stagedName}")
if(EXISTS "${staged}")
    file(REAL_PATH "${SOURCE}" sourcePath)
    file(REAL_PATH "${staged}" stagedPath)
    if(NOT sourcePath STREQUAL stagedPath)
        file(COPY_FILE "${SOURCE}" "${staged}" ONLY_IF_DIFFERENT RESULT copyResult)
        if(NOT copyResult EQUAL 0)
            message(WARNING "${staged} still holds an older ${stagedName}: ${copyResult}")
        endif()
    endif()
endif()
