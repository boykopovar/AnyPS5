function(add_bundled_subdirectory)
    if(NOT ARGN)
        message(FATAL_ERROR "add_bundled_subdirectory needs the arguments of add_subdirectory")
    endif()
    get_directory_property(anyps5SavedLinkLibraries LINK_LIBRARIES)
    set_directory_properties(PROPERTIES LINK_LIBRARIES "")
    add_subdirectory(${ARGN})
    set_directory_properties(PROPERTIES LINK_LIBRARIES "${anyps5SavedLinkLibraries}")
endfunction()
