function(add_bundled_opus)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_TESTING OFF)
    set(OPUS_BUILD_SHARED_LIBRARY OFF)
    set(OPUS_BUILD_TESTING OFF)
    set(OPUS_BUILD_PROGRAMS OFF)
    set(OPUS_INSTALL_PKG_CONFIG_MODULE OFF)
    set(OPUS_INSTALL_CMAKE_CONFIG_MODULE OFF)
    set(OPUS_STACK_PROTECTOR OFF)
    set(OPUS_FORTIFY_SOURCE OFF)
    add_subdirectory(3rdparty/opus EXCLUDE_FROM_ALL)
    set_target_properties(opus PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
    target_compile_definitions(opus PRIVATE OPUS_EXPORT=)
    if(MINGW OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_options(opus INTERFACE LINKER:--exclude-libs,libopus.a)
    endif()
endfunction()

add_bundled_opus()
