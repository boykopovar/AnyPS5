file(GLOB executables "${EXECUTABLES}/*.exe")
if(NOT executables)
    message(FATAL_ERROR "no executables in ${EXECUTABLES}")
endif()
set(failures "")
foreach(executable IN LISTS executables)
    file(STRINGS "${executable}" levels REGEX "requestedExecutionLevel level=\"asInvoker\"" LIMIT_COUNT 1)
    if(NOT levels)
        get_filename_component(name "${executable}" NAME)
        list(APPEND failures "${name}: no asInvoker manifest, so a name containing install, setup or update needs elevation to run")
    endif()
endforeach()
if(failures)
    list(JOIN failures "\n" text)
    message(FATAL_ERROR "${text}")
endif()
