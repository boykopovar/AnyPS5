set(compiler "${CMAKE_ARGV4}")
set(arguments)
set(hasPreprocessorOverride OFF)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(index RANGE 5 ${last})
    set(argument "${CMAKE_ARGV${index}}")
    if(argument MATCHES "^--preprocessor(-arg)?(=|$)")
        set(hasPreprocessorOverride ON)
    endif()
    string(REPLACE ";" "\\;" argument "${argument}")
    list(APPEND arguments "${argument}")
endforeach()
if(NOT hasPreprocessorOverride)
    get_filename_component(compilerDirectory "${compiler}" DIRECTORY)
    set(ENV{PATH} "${compilerDirectory};$ENV{PATH}")
    list(PREPEND arguments --preprocessor=gcc.exe --preprocessor-arg=-E --preprocessor-arg=-xc --preprocessor-arg=-DRC_INVOKED)
endif()
execute_process(COMMAND "${compiler}" ${arguments} COMMAND_ERROR_IS_FATAL ANY)
