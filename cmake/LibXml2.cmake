function(add_bundled_libxml2)
    if(TARGET LibXml2)
        return()
    endif()

    set(BUILD_SHARED_LIBS OFF)
    set(LIBXML2_WITH_AUTOMATA ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_C14N OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_CATALOG OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_DEBUG OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_DOCB OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_EXPR ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_FTP OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_HTML OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_HTTP OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_ICONV OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_ICU OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_ISO8859X ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_LEGACY ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_LZMA OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_MEM_DEBUG OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_MODULES OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_OUTPUT ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_PATTERN ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_PROGRAMS OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_PUSH ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_PYTHON OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_READER OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_REGEXPS ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_RUN_DEBUG OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_SAX1 ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_SCHEMAS OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_SCHEMATRON OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_TESTS OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_THREADS ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_THREAD_ALLOC OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_TREE ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_UNICODE ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_VALID ON CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_WRITER OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_XINCLUDE OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_XPATH OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_XPTR OFF CACHE BOOL "" FORCE)
    set(LIBXML2_WITH_ZLIB OFF CACHE BOOL "" FORCE)

    add_subdirectory(${CMAKE_SOURCE_DIR}/3rdparty/libxml2 ${CMAKE_BINARY_DIR}/3rdparty/libxml2 EXCLUDE_FROM_ALL)
    if(WIN32)
        get_target_property(xmlSources LibXml2 SOURCES)
        list(FILTER xmlSources EXCLUDE REGEX "\\.rc$")
        set_target_properties(LibXml2 PROPERTIES SOURCES "${xmlSources}")
    endif()
    set_target_properties(LibXml2 PROPERTIES
        POSITION_INDEPENDENT_CODE ON
        C_VISIBILITY_PRESET hidden
    )
    target_compile_definitions(LibXml2 PUBLIC LIBXML_STATIC)
    if(MINGW OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_options(LibXml2 INTERFACE LINKER:--exclude-libs,libxml2.a)
    endif()
endfunction()

add_bundled_libxml2()
