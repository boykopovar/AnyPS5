# Usage: cmake -DDEST_DIR=<dir> -P CopyRuntimeFiles.cmake <file>...
# Several test executables stage the same prx files into one directory in parallel. On Windows the
# concurrent copies can fail with "Permission denied" or "No such file or directory", so each copy retries.
if(NOT DEST_DIR)
    message(FATAL_ERROR "DEST_DIR is required")
endif()
set(ANYPS5_COPY_ATTEMPTS 20)
math(EXPR lastArg "${CMAKE_ARGC} - 1")
foreach(argIndex RANGE 3 ${lastArg})
    set(source "${CMAKE_ARGV${argIndex}}")
    get_filename_component(name "${source}" NAME)
    get_filename_component(sourceDir "${source}" DIRECTORY)
    get_filename_component(destDir "${DEST_DIR}" ABSOLUTE)
    if("${sourceDir}" STREQUAL "${destDir}")
        continue()
    endif()
    set(copied FALSE)
    foreach(attempt RANGE 1 ${ANYPS5_COPY_ATTEMPTS})
        file(MAKE_DIRECTORY "${DEST_DIR}")
        file(COPY_FILE "${source}" "${DEST_DIR}/${name}" ONLY_IF_DIFFERENT RESULT result)
        if(result STREQUAL "0")
            set(copied TRUE)
            break()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.25)
    endforeach()
    if(NOT copied)
        message(FATAL_ERROR "Could not copy ${source} to ${DEST_DIR} after ${ANYPS5_COPY_ATTEMPTS} attempts: ${result}")
    endif()
endforeach()
