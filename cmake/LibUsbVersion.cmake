if(NOT DEFINED VERSION_FILE OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "VERSION_FILE and OUTPUT are required")
endif()
file(READ "${VERSION_FILE}" version)
string(REGEX REPLACE "[\r\n ]" "" version "${version}")
if(version STREQUAL "")
    message(FATAL_ERROR "libusb version lock is empty")
endif()
string(REPLACE "\\" "\\\\" version "${version}")
string(REPLACE "\"" "\\\"" version "${version}")
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT}.tmp" "#ifndef LIBUSB_DESCRIBE\n#define LIBUSB_DESCRIBE \"${version}\"\n#endif\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" RESULT_VARIABLE result)
file(REMOVE "${OUTPUT}.tmp")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not publish libusb version header")
endif()
