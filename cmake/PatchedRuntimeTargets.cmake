include_guard(GLOBAL)

function(add_patched_runtime_targets target)
    add_custom_target(${target})
    set(index 0)
    foreach(output IN LISTS ARGN)
        set(driver ${target}_output_${index})
        add_custom_target(${driver} DEPENDS "${output}")
        add_dependencies(${target} ${driver})
        get_filename_component(module "${output}" NAME_WLE)
        set(alias ${target}_${module})
        if(TARGET ${alias})
            message(FATAL_ERROR "add_patched_runtime_targets: ${output} would reuse the target name ${alias}")
        endif()
        add_custom_target(${alias})
        add_dependencies(${alias} ${driver})
        math(EXPR index "${index} + 1")
    endforeach()
endfunction()
